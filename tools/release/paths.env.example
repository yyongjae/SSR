# Copy to tools/release/paths.env (ignored by git) on a new server and edit.  scripts/experiment.sh loads that file.
# Every variable is optional: navsim/common/ssr_paths.py falls back to the reference server's path, so a line left out
# means that path.  An empty value counts as unset.  Values below show how each default is derived.

# Refiner data root: ck/, metric_cache, objects, sdf, e2e_side, splits, human.
#SSR_DATA_ROOT=/path/to/yongjae_refiner

# Teacher BEV caches: <here>/bevfusion/cache_{train,val}_100x100, <here>/resmap/stage1_front64.
# Also the default of agent.config.distill_feature_root.
#SSR_TEACHER_CACHE=/path/to/teacher_cache

# Dataset, with navsim_logs/{trainval,test} and sensor_blobs/{trainval,test}.  navsim_logs/trainval must hold the log
# pickles directly (not a nested trainval/trainval).
#OPENSCENE_DATA_ROOT=/path/to/dataset

# Maps (nuplan-maps-v1.0).  Default: <OPENSCENE_DATA_ROOT>/maps
#NUPLAN_MAPS_ROOT=/path/to/dataset/maps

# Test logs and sensors: <here>/navsim_logs/test/test, <here>/sensor_blobs/test/test.
#SSR_TEST_DATA_ROOT=/path/to/dataset

# Directory with pdm_score_256.npy and pdm_score_256.tokens.json.  The anchors are in the repo
# (resources/planning_vb/trajectory_anchors_256.npy).
#SSR_PLAN_DATA=/path/to/planning_vb

# Fork navtest metric cache, research tools only.  Reported numbers use NAVSIM_V11_CACHE.
#SSR_NAVTEST_MC=/path/to/exp/metric_cache

# Python interpreter of the environment, and its torchrun.
#SSR_PY=/venv/ssr/bin/python
#SSR_TORCHRUN=/venv/ssr/bin/torchrun

# Run folders.  Default: <SSR_DATA_ROOT>/v7/e2e
#SSR_RUN_ROOT=/path/to/runs

# Pristine official NAVSIM v1.1 tree.  Default: <SSR_DATA_ROOT>/v7/eval/official_v11/navsim_v1.1
#NAVSIM_V11=/path/to/navsim_v1.1

# Navtest metric cache built by that tree.  Default: <SSR_DATA_ROOT>/v7/eval/official_v11/exp/metric_cache_navtest_v11
#NAVSIM_V11_CACHE=/path/to/exp/metric_cache_navtest_v11

# NAVSIM v2.2 tree for EPDMS after the upstream fix, the same tree before it, and the navtest metric cache built by v2.2.
#NAVSIM_V22_POST=/path/to/navsim
#NAVSIM_V22_PRE=/path/to/navsim_prefix
#NAVSIM_V22_CACHE=/path/to/metric_cache_v22_navtest

# Navhard two-stage metric cache built by v2.2.  Only tools/release/navhard.sh reads it.
#NAVSIM_V22_NAVHARD_CACHE=/path/to/metric_cache_navhard_two_stage_v22

# Older research checkout (report/, work_dirs/).  Only research checks read it (the verify-* commands of
# tools/refiner/build_metric_cache.py, tools/refiner/check_scorer_equivalence.py).  May be absent.
#SSR_RESEARCH_TREE=/path/to/SSR
