+"""Dump the trained BEVFormer NAVSIM teacher's BEV and boxes as the per-token cache SSR reads.
+
+This file ships in tools/release/teachers/patches/bevformer_navsim.patch as tools/navsim_cache_teacher.py of
+yyongjae/BEVFormer @ 9f1d5df (SSR keeps the reviewed copy in tools/release/teachers/; tests/test_simscale_teachers.py
+checks the two are the same).  Run it from the BEVFormer checkout with the teacher env (setup_teacher_env.sh).
+
+Layout (refiner/data.py TeacherCache, distill/teacher_store.py TeacherFeatureStore; = the reference cache):
+    <out>/samples/<token[:2]>/<token>.npz     uncompressed (np.savez), one per in-split token
+        bev_feature     float16 (256, 100, 100)  bev_embed (encoder output, the detection decoder memory),
+                                                 reshape(H=y, W=x, C).permute(2, 1, 0): (C, x_forward 0..64 m,
+                                                 y_left -32..32 m ascending), 0.64 m cells, origin the rear axle
+        pred_boxes_3d   float32 (200, 9)         [x, y, z_gravity_centre, dx, dy, dz, yaw, vx, vy], mmdet3d LiDAR
+        pred_scores_3d  float32 (200,)           top 200 by score of the NMS-free decoder output (max_num 300),
+        pred_labels_3d  int16   (200,)           zero-padded, label -1 pad
+    <out>/passes/<pass>/provenance.json, done_r<rank>.json      one pass = one info pkl (+ token list)
+<out>/manifest.json is written by SSR (tools/release/teachers/teacher_caches.py det-manifest) once the passes are done.
+
+Temporal context, as the reference cache ("video_test_mode over every pool frame in log order (filter_by_split off),
+prev_bev reset at prev-chain breaks; only in_split_tokens frames written"): the dataset is built with filter_by_split
+off, so its sample list is the whole frame pool and its sample-level segment string changes exactly at prev-chain
+breaks; forward_test resets prev_bev whenever that string changes.  prev_bev of a frame depends only on the earlier
+frames of its segment, so running each segment that holds a target from its FIRST frame up to its LAST target gives a
+target subset (--token-list) the same input as the full run; frames after the last target, and segments without a
+target, cannot change any written token and are skipped.  Targets must be in-split frames of the info pkl.
+
+Ranks (--rank / --world, or RANK / WORLD_SIZE) take whole logs, balanced on the frames of their planned segments, so
+a chain never crosses ranks and no process group is needed; one process per GPU (CUDA_VISIBLE_DEVICES).  The
+assignment does not depend on what is already written, so ranks started at different times agree on it.  --resume
+skips targets whose npz is complete and runs a segment only up to its last missing target; a pass is pinned to one
+checkpoint, config, info pkl and token list (provenance.json), --resume refuses another one.
+
+    python tools/navsim_cache_teacher.py --cfg <bundle>/bevformer_navsim_base.py --ckpt <bundle>/epoch_5.pth \
+        --ann-file infos/navsim_infos_navtrain.pkl --out <SSR_TEACHER_CACHE>/bevformer/cache_train_100x100 \
+        --pass real --rank 0 --world 2 --resume [--token-list tokens.txt] [--expect-sha-head 4ca4f1aa55011beb]
+
+To change this file: edit tools/release/teachers/navsim_cache_teacher.py, copy it into a get_teachers.sh checkout as
+tools/navsim_cache_teacher.py, and rewrite the patch there with `git add -A && git diff --cached --binary`.
+"""
+import argparse
+import hashlib
+import json
+import os
+import os.path as osp
+import subprocess
+import sys
+import time
+from datetime import datetime, timedelta, timezone
+
+import numpy as np
+
+BEV_C, BEV_H, BEV_W = 256, 100, 100
+NUM_BOXES = 200
+NPZ_KEYS = ('bev_feature', 'pred_boxes_3d', 'pred_scores_3d', 'pred_labels_3d')
+NPZ_MIN_BYTES = BEV_C * BEV_H * BEV_W * 2          # bev_feature alone, float16
+PROV_PINNED = ('checkpoint_sha256', 'config_sha256', 'ann_file', 'ann_file_bytes', 'token_list_sha256')
+
+
+def parse_args(argv=None):
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument('--cfg', required=True, help='bevformer_navsim_base.py (the config the checkpoint was trained with)')
+    p.add_argument('--ckpt', required=True)
+    p.add_argument('--ann-file', required=True, help='tools/data_converter/navsim_converter.py output (the frame pool)')
+    p.add_argument('--out', required=True, help='cache root, e.g. <SSR_TEACHER_CACHE>/bevformer/cache_train_100x100')
+    p.add_argument('--pass', dest='pass_name', required=True, help='name of this pass, e.g. real or sim_r4')
+    p.add_argument('--token-list', default=None, help='text file of target tokens (default: every in-split frame)')
+    p.add_argument('--rank', type=int, default=int(os.environ.get('RANK', 0)))
+    p.add_argument('--world', type=int, default=int(os.environ.get('WORLD_SIZE', 1)))
+    p.add_argument('--workers', type=int, default=6)
+    p.add_argument('--data-root', default=None, help='override data.test.data_root (for relative image paths)')
+    p.add_argument('--expect-sha-head', default=None, help='refuse a checkpoint whose sha256 does not start with this')
+    p.add_argument('--resume', action='store_true', help='continue a pass (skip complete npz files)')
+    p.add_argument('--limit', type=int, default=0, help='stop after N frames on this rank (dry run)')
+    p.add_argument('--plan-only', action='store_true', help='print the plan of every rank as JSON and exit')
+    return p.parse_args(argv)
+
+
+# ----------------------------------------------------------------------------------------------- plan (numpy only)
+def segment_runs(segments):
+    """[(start, stop)] of the runs of equal consecutive entries of `segments` (frame indices, stop exclusive)."""
+    runs, start = [], 0
+    for i in range(1, len(segments) + 1):
+        if i == len(segments) or segments[i] != segments[start]:
+            runs.append((start, i))
+            start = i
+    return runs
+
+
+def plan_segments(segments, logs, target_idx):
+    """[(log, start, stop, targets)] for every segment that holds a target frame: frames start..stop-1 are run, stop =
+    the last target + 1; targets = the sorted target frame indices of the segment.  Segments are in frame order."""
+    targets = sorted(set(int(i) for i in target_idx))
+    plan, k = [], 0
+    for start, stop in segment_runs(segments):
+        mine = []
+        while k < len(targets) and targets[k] < stop:
+            if targets[k] >= start:
+                mine.append(targets[k])
+            k += 1
+        if mine:
+            plan.append((logs[start], start, mine[-1] + 1, mine))
+    return plan
+
+
+def shard_logs(plan, world):
+    """Rank of every log of `plan`: whole logs, the heaviest (most frames to run) first onto the least loaded rank,
+    ties by log name, so every rank computes the same assignment."""
+    frames = {}
+    for log, start, stop, _ in plan:
+        frames[log] = frames.get(log, 0) + stop - start
+    load = [0] * world
+    owner = {}
+    for log in sorted(frames, key=lambda g: (-frames[g], g)):
+        r = min(range(world), key=lambda i: (load[i], i))
+        owner[log] = r
+        load[r] += frames[log]
+    return owner
+
+
+def rank_plan(plan, owner, rank, pending):
+    """This rank's segments, trimmed to their last pending target; segments with nothing pending are dropped.
+    -> [(log, start, stop, pending targets)]."""
+    out = []
+    for log, start, stop, targets in plan:
+        if owner[log] != rank:
+            continue
+        left = [t for t in targets if t in pending]
+        if left:
+            out.append((log, start, left[-1] + 1, left))
+    return out
+
+
+# ----------------------------------------------------------------------------------------------- cache files
+def npz_path(out, token):
+    return osp.join(out, 'samples', token[:2], f'{token}.npz')
+
+
+def npz_complete(path):
+    """True if the file holds every member with the cache shapes (a crash leaves no partial file: writes are atomic,
+    but a file from another writer could be short)."""
+    try:
+        if os.path.getsize(path) < NPZ_MIN_BYTES:
+            return False
+        with np.load(path, allow_pickle=False) as z:
+            return set(NPZ_KEYS) <= set(z.files) and z['bev_feature'].shape == (BEV_C, BEV_H, BEV_W)
+    except (OSError, ValueError, KeyError, EOFError):
+        return False
+
+
+def write_npz(path, arrays):
+    """np.savez (uncompressed) to a temporary file in the same directory, then an atomic rename."""
+    os.makedirs(osp.dirname(path), exist_ok=True)
+    tmp = osp.join(osp.dirname(path), f'.{osp.basename(path)}.{os.getpid()}.tmp')
+    with open(tmp, 'wb') as fh:
+        np.savez(fh, **arrays)
+    os.replace(tmp, path)
+
+
+def bev_from_embed(embed, bev_h=BEV_H, bev_w=BEV_W):
+    """bev_embed (bev_h * bev_w, 1, C) -> float16 (C, x = bev_w, y = bev_h), i.e. reshape(H=y, W=x, C).permute(2, 1, 0).
+    Query q = h * bev_w + w sits at y = pc_range[1] + (h + 0.5) * cell, x = pc_range[0] + (w + 0.5) * cell."""
+    x = np.asarray(embed)
+    if x.ndim == 3:
+        assert x.shape[1] == 1, f'one sample per batch expected, bev_embed {x.shape}'
+        x = x[:, 0]
+    assert x.shape[0] == bev_h * bev_w, f'bev_embed {x.shape} is not ({bev_h} * {bev_w}, C)'
+    return np.ascontiguousarray(x.reshape(bev_h, bev_w, -1).transpose(2, 1, 0).astype(np.float16))
+
+
+def box_arrays(centres, rest, scores, labels, k=NUM_BOXES):
+    """Top-k boxes by score: centres (N, 3) gravity centres, rest (N, 6) = dx, dy, dz, yaw, vx, vy.  -> pred_boxes_3d
+    (k, 9) f32, pred_scores_3d (k,) f32, pred_labels_3d (k,) i16; padding: zero boxes / scores, label -1."""
+    centres, rest = np.asarray(centres, np.float32).reshape(-1, 3), np.asarray(rest, np.float32).reshape(-1, 6)
+    scores, labels = np.asarray(scores, np.float32).reshape(-1), np.asarray(labels).reshape(-1)
+    order = np.argsort(-scores, kind='stable')[:k]
+    n = len(order)
+    boxes = np.zeros((k, 9), np.float32)
+    out_scores = np.zeros(k, np.float32)
+    out_labels = np.full(k, -1, np.int16)
+    boxes[:n] = np.concatenate([centres[order], rest[order]], 1)
+    out_scores[:n] = scores[order]
+    out_labels[:n] = labels[order].astype(np.int16)
+    return boxes, out_scores, out_labels
+
+
+def read_tokens(path):
+    with open(path) as fh:
+        return [t.strip() for t in fh if t.strip()]
+
+
+# ----------------------------------------------------------------------------------------------- provenance
+def sha256_file(path, chunk=1 << 20):
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for block in iter(lambda: f.read(chunk), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def git_state(repo):
+    """HEAD and the sha256 of `git diff HEAD` of the checkout this file runs from (None outside git)."""
+    try:
+        head = subprocess.run(['git', '-C', repo, 'rev-parse', 'HEAD'], capture_output=True, text=True,
+                              check=True).stdout.strip()
+        diff = subprocess.run(['git', '-C', repo, 'diff', 'HEAD', '--binary'], capture_output=True,
+                              check=True).stdout
+        return head, hashlib.sha256(diff).hexdigest()
+    except (OSError, subprocess.CalledProcessError):
+        return None, None
+
+
+def check_provenance(pass_dir, prov, resume):
+    """One pass = one checkpoint, config, info pkl and token list.  A new pass refuses an existing one unless --resume;
+    --resume refuses different pinned settings.  Every rank calls this; the first one writes the file."""
+    path = osp.join(pass_dir, 'provenance.json')
+    if osp.exists(path):
+        with open(path) as f:
+            old = json.load(f)
+        if not resume:
+            raise SystemExit(f'{pass_dir} already holds a pass (provenance.json); use --resume or another --pass')
+        diff = {k: (old.get(k), prov.get(k)) for k in PROV_PINNED if old.get(k) != prov.get(k)}
+        if diff:
+            raise SystemExit(f'--resume of {pass_dir} with different settings: {diff}')
+        return old
+    os.makedirs(pass_dir, exist_ok=True)
+    tmp = f'{path}.{os.getpid()}.tmp'
+    with open(tmp, 'w') as f:
+        json.dump(prov, f, indent=2)
+    os.replace(tmp, path)
+    return prov
+
+
+# ----------------------------------------------------------------------------------------------- model / data
+def build(args, repo):
+    """(dataset, model) as tools/test.py builds them, with the dataset over the whole frame pool."""
+    import torch
+    from mmcv import Config
+    from mmcv.parallel import MMDataParallel
+    from mmcv.runner import load_checkpoint, wrap_fp16_model
+
+    sys.path.insert(0, repo)
+    import projects.mmdet3d_plugin  # noqa: F401  registers the plugin modules
+    from mmdet3d.datasets import build_dataset
+    from mmdet3d.models import build_model
+
+    cfg = Config.fromfile(args.cfg)
+    assert cfg.model.get('video_test_mode', False), 'the cache is video_test_mode (prev_bev along the chain)'
+    test = cfg.data.test
+    test.pop('samples_per_gpu', None)
+    test.ann_file = osp.abspath(args.ann_file)
+    test.test_mode = True
+    test.filter_by_split = False          # sample list = the whole pool, segments change at prev-chain breaks
+    if args.data_root:
+        test.data_root = args.data_root
+    cfg.model.pretrained = None
+    cfg.model.train_cfg = None
+    dataset = build_dataset(test)
+    model = build_model(cfg.model, test_cfg=cfg.get('test_cfg'))
+    if cfg.get('fp16', None) is not None:
+        wrap_fp16_model(model)
+    load_checkpoint(model, args.ckpt, map_location='cpu', strict=True)
+    model = MMDataParallel(model.cuda(), device_ids=[torch.cuda.current_device()]).eval()
+    head = model.module.pts_bbox_head
+    assert (head.bev_h, head.bev_w, head.embed_dims) == (BEV_H, BEV_W, BEV_C), (head.bev_h, head.bev_w)
+    return dataset, model
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    repo = osp.dirname(osp.dirname(osp.abspath(__file__)))
+    assert 0 <= args.rank < args.world, (args.rank, args.world)
+    import torch
+
+    # the dataset holds objects a spawn start method would have to pickle; mmcv's init switches it otherwise
+    torch.multiprocessing.set_start_method('fork', force=True)
+    t_start = time.time()
+    ckpt_sha = sha256_file(args.ckpt)
+    if args.expect_sha_head and not ckpt_sha.startswith(args.expect_sha_head):
+        raise SystemExit(f'{args.ckpt}: sha256 {ckpt_sha[:16]} != expected head {args.expect_sha_head}')
+    dataset, model = build(args, repo)
+    infos = dataset.data_infos
+    tokens = [i['token'] for i in infos]
+    in_split = np.array([bool(i.get('in_split_tokens', True)) for i in infos])
+    if args.token_list:
+        want = read_tokens(args.token_list)
+        pos = {t: i for i, t in enumerate(tokens)}
+        lost = [t for t in want if t not in pos]
+        if lost:
+            raise SystemExit(f'{len(lost)} of {len(want)} --token-list tokens are not in {args.ann_file}, e.g. {lost[:3]}')
+        target_idx = sorted(pos[t] for t in set(want))
+        off = [tokens[i] for i in target_idx if not in_split[i]]
+        if off:
+            raise SystemExit(f'{len(off)} --token-list tokens are history-only frames of the pool, e.g. {off[:3]}')
+    else:
+        target_idx = np.flatnonzero(in_split).tolist()
+    segments = list(dataset.sample_segment)       # filter_by_split off: one entry per pool frame
+    assert len(segments) == len(infos)
+    logs = [i['log_name'] for i in infos]
+    plan = plan_segments(segments, logs, target_idx)
+    owner = shard_logs(plan, args.world)
+
+    out = osp.abspath(args.out)
+    pass_dir = osp.join(out, 'passes', args.pass_name)
+    head_sha, diff_sha = git_state(repo)
+    prov = dict(checkpoint=osp.abspath(args.ckpt), checkpoint_sha256=ckpt_sha, checkpoint_sha256_head=ckpt_sha[:16],
+                config=osp.abspath(args.cfg), config_sha256=sha256_file(args.cfg),
+                ann_file=osp.abspath(args.ann_file), ann_file_bytes=os.path.getsize(args.ann_file),
+                ann_metadata=getattr(dataset, 'metadata', {}),
+                token_list=osp.abspath(args.token_list) if args.token_list else None,
+                token_list_sha256=sha256_file(args.token_list) if args.token_list else None,
+                n_pool_frames=len(infos), n_in_split=int(in_split.sum()), n_targets=len(target_idx),
+                n_frames_planned=int(sum(s1 - s0 for _, s0, s1, _ in plan)), world_size=args.world,
+                git_commit=head_sha, git_diff_sha256=diff_sha, script=osp.abspath(__file__),
+                script_sha256=sha256_file(osp.abspath(__file__)),
+                torch=torch.__version__, cuda=torch.version.cuda, gpu=torch.cuda.get_device_name(),
+                cudnn_allow_tf32=bool(torch.backends.cudnn.allow_tf32),
+                matmul_allow_tf32=bool(torch.backends.cuda.matmul.allow_tf32),
+                temporal='video_test_mode over the pool frames of every prev-chain segment holding a target, in log '
+                         'order, from the segment start to its last target; prev_bev reset at chain breaks; only '
+                         'target (in-split) frames written',
+                created=datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S%z'))
+    if args.plan_only:
+        ranks = []
+        for r in range(args.world):
+            mine = [p for p in plan if owner[p[0]] == r]
+            ranks.append(dict(rank=r, logs=len({p[0] for p in mine}), segments=len(mine),
+                              frames=int(sum(s1 - s0 for _, s0, s1, _ in mine)), targets=sum(len(p[3]) for p in mine)))
+        print(json.dumps(dict(prov, ranks=ranks), indent=2))
+        return
+    check_provenance(pass_dir, prov, args.resume)
+
+    mine_all = [p for p in plan if owner[p[0]] == args.rank]
+    pending = {t for _, _, _, tg in mine_all for t in tg if not npz_complete(npz_path(out, tokens[t]))}
+    todo = rank_plan(plan, owner, args.rank, pending)
+    frames = [i for _, s0, s1, _ in todo for i in range(s0, s1)]
+    if args.limit:
+        frames = frames[:args.limit]
+    write = {t for _, _, _, tg in todo for t in tg}
+    n_targets = sum(len(tg) for _, _, _, tg in mine_all)
+    print(f'[rank {args.rank}/{args.world}] pass {args.pass_name}: {len(mine_all)} segments, {n_targets} targets '
+          f'({n_targets - len(pending)} done), {len(frames)} frames to run for {len(write)} tokens', flush=True)
+    if frames:
+        cam_paths = dataset.get_data_info(frames[0])['img_filename']
+        missing = [p for p in cam_paths if not osp.isfile(p)]
+        if missing:
+            raise SystemExit(f'image {missing[0]} not found: build the info pkl with an absolute --sensor-prefix or '
+                             f'pass --data-root')
+
+    from mmcv.parallel import collate
+    loader = torch.utils.data.DataLoader(
+        torch.utils.data.Subset(dataset, frames), batch_size=1, shuffle=False, num_workers=args.workers,
+        collate_fn=lambda b: collate(b, samples_per_gpu=1), pin_memory=False)
+    core = model.module
+    t0, n, written = time.time(), 0, 0
+    with torch.no_grad():
+        for k, data in enumerate(loader):
+            fi = frames[k]
+            result = model(return_loss=False, rescale=True, **data)
+            if fi in write:
+                bev = bev_from_embed(core.prev_frame_info['prev_bev'].float().cpu().numpy(), BEV_H, BEV_W)
+                det = result[0]['pts_bbox']
+                b = det['boxes_3d']
+                boxes, scores, labels = box_arrays(b.gravity_center.numpy(), b.tensor[:, 3:9].numpy(),
+                                                   det['scores_3d'].numpy(), det['labels_3d'].numpy())
+                write_npz(npz_path(out, tokens[fi]), dict(bev_feature=bev, pred_boxes_3d=boxes,
+                                                          pred_scores_3d=scores, pred_labels_3d=labels))
+                written += 1
+                if written == 1:
+                    print(f'    bev_feature {bev.shape} {bev.dtype} range [{float(bev.min()):.3f}, '
+                          f'{float(bev.max()):.3f}], {int((scores > 0).sum())} boxes', flush=True)
+            n += 1
+            if n % 500 == 0:
+                rate = n / (time.time() - t0)
+                print(f'[rank {args.rank}] {n}/{len(frames)} frames {rate:.2f} frames/s, {written} written, '
+                      f'eta {timedelta(seconds=int((len(frames) - n) / max(rate, 1e-6)))}', flush=True)
+    sec = time.time() - t0
+    done = dict(rank=args.rank, world=args.world, logs=len({p[0] for p in mine_all}), frames=n, written=written,
+                skipped=n_targets - len(pending), targets=n_targets, sec=round(sec, 1),
+                frames_per_sec=round(n / sec, 3) if sec > 0 else None, wall_sec=round(time.time() - t_start, 1),
+                limit=args.limit or None)
+    path = osp.join(pass_dir, f'done_r{args.rank}.json')
+    with open(f'{path}.tmp', 'w') as f:
+        json.dump(done, f)
+    os.replace(f'{path}.tmp', path)
+    print(f'[rank {args.rank}] done: {json.dumps(done)}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
