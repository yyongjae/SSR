index 0000000..ee80f19
--- /dev/null
+++ b/tools/navsim/bnft_front64.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+# BN-calibration fine-tune of a finished front64 run: one short epoch (every 4th train frame) with every BatchNorm
+# frozen in eval mode, so eval-mode predictions / cached BEV features match the train-mode network (FreezeBNHook).
+#
+#   GPUS=0,1,2,3 bash tools/navsim/bnft_front64.sh <run_work_dir>/epoch_18.pth
+#
+# The config is <run config>_bnft.py, picked from the config tools/train.py dumped into the run's work_dir (baseline
+# or undist); the result goes to <run_work_dir>_bnft/epoch_1.pth and is evaluated on val at the end.  lr defaults to
+# 1e-4 at global batch 64, scaled linearly.  Extra config overrides go in CFG_OPTIONS.
+set -euo pipefail
+CKPT=${1:?usage: bnft_front64.sh <ckpt> [extra tools/train.py args]}
+shift
+[ -f "$CKPT" ] || { echo "bnft_front64.sh: no such checkpoint: $CKPT" >&2; exit 2; }
+CKPT=$(readlink -f "$CKPT")
+REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+RUN_DIR=$(dirname "$CKPT")
+RUN_CFG=$(ls "$RUN_DIR"/M2M_navsim_*.py | head -1)
+export CFG=${CFG:-$REPO/projects/configs/mask2map_navsim/$(basename "$RUN_CFG" .py)_bnft.py}
+[ -f "$CFG" ] || { echo "bnft_front64.sh: no fine-tune config $CFG" >&2; exit 2; }
+GPUS=${GPUS:-0,1,2,3}
+SPG=${SPG:-16}
+NGPU=$(echo "$GPUS" | tr ',' '\n' | grep -c .)
+export GPUS SPG
+export LR=${LR:-$(python3 -c "print(1e-4 * $NGPU * $SPG / 64)")}
+export WORK_DIR=${WORK_DIR:-${RUN_DIR}_bnft}
+export PORT=${PORT:-$((29660 + ${GPUS%%,*}))}  # per first GPU, so runs on disjoint GPU sets do not collide
+export CFG_OPTIONS="load_from=$CKPT ${CFG_OPTIONS:-}"
+echo "[bnft_front64] from $CKPT"
+exec bash "$REPO/tools/navsim/train_front64.sh" "$@"
diff --git a/tools/navsim/cache_teacher_m2m.py b/tools/navsim/cache_teacher_m2m.py
