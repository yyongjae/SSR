@@ -0,0 +1,37 @@
+"""ReSMap stage-1 BEV semantic segmentation loss (ReSMap plugin/models/losses/seg_loss.py: MaskFocalLoss + MaskDiceLoss),
+as one loss module for the Mask2Map head's `loss_seg` slot.
+
+pred (B, C, H, W) logits, target (B, C, H, W) {0, 1}: sigmoid focal loss averaged over classes x focal_weight
++ (1 - mean dice over batch and classes) x dice_weight.
+"""
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from mmdet.models import LOSSES
+
+
+def sigmoid_focal_loss(pred, target, gamma=2.0, alpha=0.25):
+    p = pred.sigmoid()
+    target = target.type_as(pred)
+    pt = (1 - p) * target + p * (1 - target)
+    w = (alpha * target + (1 - alpha) * (1 - target)) * pt.pow(gamma)
+    return (F.binary_cross_entropy_with_logits(pred, target, reduction='none') * w).mean()
+
+
+@LOSSES.register_module()
+class ReSMapSegLoss(nn.Module):
+
+    def __init__(self, focal_weight=10.0, dice_weight=1.0, gamma=2.0, alpha=0.25, loss_weight=1.0):
+        super().__init__()
+        self.focal_weight, self.dice_weight = focal_weight, dice_weight
+        self.gamma, self.alpha = gamma, alpha
+        self.loss_weight = loss_weight
+        self.smooth = 1e-5
+
+    def forward(self, pred, target):
+        pred, target = pred.float(), target.float()
+        focal = sum(sigmoid_focal_loss(pred[:, c], target[:, c], self.gamma, self.alpha)
+                    for c in range(pred.size(1))) / pred.size(1)
+        p, t = pred.sigmoid().flatten(2), target.flatten(2)
+        dice = 1 - ((2 * (p * t).sum(2) + self.smooth) / ((p * p).sum(2) + t.sum(2) + self.smooth)).mean()
+        return self.loss_weight * (self.focal_weight * focal + self.dice_weight * dice)
