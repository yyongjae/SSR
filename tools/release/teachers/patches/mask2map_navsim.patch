+++ b/tools/navsim/navsim_map_gt.py
@@ -0,0 +1,213 @@
+#!/usr/bin/env python
+"""NAVSIM map ground truth (road / walkway / centerline / crosswalk) from nuPlan's own map API.
+
+This is resmap_navsim/tools/navsim_map_gt.py with its hard-coded paths turned into arguments and the front64 ROI as
+the default; the geometry code is unchanged, so the GT is the one the ReSMap front64 teacher was trained on
+(resmap_navsim tools/derive_front64_config.py: --roi-x 64 --roi-y 64 --roi-cx 32 --radius 72).
+
+Classes (one cat2id for every head), the layers NAVSIM's TransFuser rasterises plus CROSSWALK:
+    road        LANE + INTERSECTION polygons, unioned  -> seg: fill
+    walkway     WALKWAYS polygons                      -> seg: fill
+    centerline  LANE + LANE_CONNECTOR baseline paths   -> seg: line
+    crosswalk   CROSSWALK polygons                     -> seg: fill
+Area classes are stored as rings, [exterior, *holes], so medians and islands stay unpainted.
+
+Geometry is stored in the ROI-CENTRED ego frame: x_c = x_ego - roi_cx (forward), y_c = y_ego - roi_cy (left), clipped
+to [-roi_x / 2, roi_x / 2] x [-roi_y / 2, roi_y / 2]. Needs nuplan-devkit (e.g. /venv/theme, read-only use); the
+training env only reads the packed .npz (tools/navsim/pack_map_gt.py).
+
+    python tools/navsim/navsim_map_gt.py --infos .../navsim_map_infos_navtrain.pkl --out .../navtrain.pkl --workers 32
+"""
+import argparse
+import os
+import pickle
+import time
+from multiprocessing import Pool
+
+import numpy as np
+from shapely import affinity
+from shapely.geometry import box
+from shapely.ops import unary_union
+
+CLASSES = ('road', 'walkway', 'centerline', 'crosswalk')
+# Set from the CLI in main() (forked workers inherit them).
+MAP_ROOT = '/workspace/navsim/download/maps'
+MAP_VERSION = 'nuplan-maps-v1.0'
+RADIUS = 72.0             # reaches the far corner of the 64 x 64 box (sqrt(64^2 + 32^2) = 71.6 m)
+ROI = (64.0, 64.0)        # (forward, lateral) extent
+ROI_CENTRE = (32.0, 0.0)  # x in [0, 64] ahead of the rear axle, y in [-32, 32]
+
+
+def _local(geom, x, y, heading):
+    """Global -> ego, verbatim navsim._geometry_local_coords."""
+    a, b = np.cos(heading), np.sin(heading)
+    g = affinity.translate(geom, -x, -y)
+    return affinity.affine_transform(g, [a, b, -b, a, 0.0, 0.0])
+
+
+def _shift(geom):
+    """Ego -> ROI-centred frame (subtract the ROI centre)."""
+    return affinity.translate(geom, -ROI_CENTRE[0], -ROI_CENTRE[1])
+
+
+def _polys(geom):
+    if geom.is_empty:
+        return []
+    if geom.geom_type == 'Polygon':
+        return [geom]
+    if geom.geom_type in ('MultiPolygon', 'GeometryCollection'):
+        out = []
+        for g in geom.geoms:
+            out.extend(_polys(g))
+        return out
+    return []
+
+
+def _lines(geom):
+    if geom.is_empty:
+        return []
+    if geom.geom_type == 'LineString':
+        return [geom] if len(geom.coords) >= 2 else []
+    if geom.geom_type in ('MultiLineString', 'GeometryCollection'):
+        out = []
+        for g in geom.geoms:
+            out.extend(_lines(g))
+        return out
+    return []
+
+
+def _line(g):
+    return np.asarray(g.coords, dtype=np.float32)[:, :2]
+
+
+def _rings(p):
+    """Polygon -> [exterior, hole, hole, ...] as float32 (N, 2) arrays."""
+    return [_line(p.exterior)] + [_line(h) for h in p.interiors]
+
+
+class Extractor(object):
+    """One per city; holds the map API."""
+
+    def __init__(self, city):
+        from nuplan.common.maps.maps_datatypes import SemanticMapLayer as L
+        from nuplan.common.maps.nuplan_map.map_factory import get_maps_api
+        self.L = L
+        self.api = get_maps_api(MAP_ROOT, MAP_VERSION, city)
+        self.layers = [L.LANE, L.LANE_CONNECTOR, L.INTERSECTION, L.WALKWAYS, L.CROSSWALK]
+        hx, hy = ROI[0] / 2, ROI[1] / 2
+        self.patch = box(-hx, -hy, hx, hy)
+
+    def __call__(self, x, y, heading):
+        from nuplan.common.actor_state.state_representation import Point2D
+        L = self.L
+        objs = self.api.get_proximal_map_objects(Point2D(x, y), RADIUS, self.layers)
+
+        def to_roi(g):
+            return _shift(_local(g, x, y, heading)).intersection(self.patch)
+
+        out = {c: [] for c in CLASSES}
+        # road: union first, so adjacent lanes do not leave seams
+        road = [o.polygon for k in (L.LANE, L.INTERSECTION) for o in objs.get(k, [])]
+        if road:
+            for p in _polys(to_roi(unary_union(road))):
+                out['road'].append(_rings(p))
+        for o in objs.get(L.WALKWAYS, []):
+            for p in _polys(to_roi(o.polygon)):
+                out['walkway'].append(_rings(p))
+        for k in (L.LANE, L.LANE_CONNECTOR):
+            for o in objs.get(k, []):
+                for ls in _lines(to_roi(o.baseline_path.linestring)):
+                    out['centerline'].append(_line(ls))
+        for o in objs.get(L.CROSSWALK, []):
+            for p in _polys(to_roi(o.polygon)):
+                out['crosswalk'].append(_rings(p))
+        return out
+
+
+_EX = None
+
+
+def _init(city):
+    global _EX
+    _EX = Extractor(city)
+
+
+def _work(job):
+    tok, x, y, heading = job
+    try:
+        return tok, _EX(x, y, heading), None
+    except Exception as exc:  # keep the pool alive; report at the end
+        return tok, None, repr(exc)
+
+
+def heading_of(q):
+    """wxyz quaternion -> yaw, matching what the infos store."""
+    from pyquaternion import Quaternion
+    R = Quaternion(q).rotation_matrix
+    return float(np.arctan2(R[1, 0], R[0, 0]))
+
+
+def main():
+    global MAP_ROOT, MAP_VERSION, ROI, ROI_CENTRE, RADIUS
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--infos', required=True, help='navsim_map_infos_{split}.pkl from create_navsim_infos.py')
+    ap.add_argument('--out', required=True, help='output .pkl ({meta, gt: {token: {class: [...]}}, errors})')
+    ap.add_argument('--map-root', default=MAP_ROOT, help='dir with {city}/{version}/map.gpkg and nuplan-maps-v1.0.json')
+    ap.add_argument('--map-version', default=MAP_VERSION)
+    ap.add_argument('--workers', type=int, default=32)
+    ap.add_argument('--limit', type=int, default=0, help='debug: first N tokens')
+    ap.add_argument('--roi-x', type=float, default=ROI[0], help='forward extent (m)')
+    ap.add_argument('--roi-y', type=float, default=ROI[1], help='lateral extent (m)')
+    ap.add_argument('--roi-cx', type=float, default=ROI_CENTRE[0], help='ROI centre forward (m)')
+    ap.add_argument('--roi-cy', type=float, default=ROI_CENTRE[1])
+    ap.add_argument('--radius', type=float, default=RADIUS, help='map query radius around the ego (m)')
+    a = ap.parse_args()
+    MAP_ROOT, MAP_VERSION = a.map_root, a.map_version
+    ROI, ROI_CENTRE, RADIUS = (a.roi_x, a.roi_y), (a.roi_cx, a.roi_cy), a.radius
+    far = np.hypot(abs(ROI_CENTRE[0]) + ROI[0] / 2, abs(ROI_CENTRE[1]) + ROI[1] / 2)
+    if RADIUS < far:
+        print(f'[gt] WARNING: radius {RADIUS} m < distance to the far ROI corner {far:.1f} m; '
+              f'the far part of the box comes out empty', flush=True)
+
+    with open(a.infos, 'rb') as fh:
+        infos = pickle.load(fh)
+    if a.limit:
+        infos = infos[:a.limit]
+    by_city = {}
+    for s in infos:
+        t = s['e2g_translation']
+        by_city.setdefault(s['location'], []).append((s['token'], float(t[0]), float(t[1]), heading_of(s['e2g_rotation'])))
+    print(f'[gt] {a.infos}: {len(infos)} tokens, ' + ', '.join(f'{c}={len(v)}' for c, v in by_city.items()), flush=True)
+
+    result, errors = {}, {}
+    t0 = time.time()
+    for city, jobs in by_city.items():
+        n = min(a.workers, len(jobs))
+        with Pool(n, initializer=_init, initargs=(city,)) as pool:
+            for i, (tok, geoms, err) in enumerate(pool.imap_unordered(_work, jobs, chunksize=16)):
+                if err is not None:
+                    errors[tok] = err
+                else:
+                    result[tok] = geoms
+                if (i + 1) % 5000 == 0:
+                    print(f'  [{city}] {i + 1}/{len(jobs)}  {time.time() - t0:.0f}s', flush=True)
+        print(f'[gt] {city}: done {len(jobs)}  ({time.time() - t0:.0f}s)', flush=True)
+
+    os.makedirs(os.path.dirname(os.path.abspath(a.out)), exist_ok=True)
+    meta = dict(classes=CLASSES, area_classes=('road', 'walkway', 'crosswalk'),
+                storage='area classes: list of polygons, each [exterior, *holes] (N,2) f32; '
+                        'centerline: list of (N,2) f32 polylines',
+                roi_size=ROI, roi_center=ROI_CENTRE, radius=RADIUS,
+                frame='roi-centred ego (x forward, y left)', map_version=MAP_VERSION,
+                source='nuplan map_api.get_proximal_map_objects, NAVSIM TransFuser layers')
+    with open(a.out, 'wb') as fh:
+        pickle.dump(dict(meta=meta, gt=result, errors=errors), fh, protocol=4)
+    per = {c: np.mean([len(g[c]) for g in result.values()]) for c in CLASSES} if result else {}
+    print(f'[gt] wrote {a.out}  ({os.path.getsize(a.out) / 2 ** 20:.0f} MiB)  tokens={len(result)} '
+          f'errors={len(errors)}  mean/frame ' + ' '.join(f'{c}={v:.1f}' for c, v in per.items()))
+    for tok, e in list(errors.items())[:5]:
+        print('   err', tok, e)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/navsim/pack_map_gt.py b/tools/navsim/pack_map_gt.py
new file mode 100644
index 0000000..3013dc9
--- /dev/null
+++ b/tools/navsim/pack_map_gt.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python
+"""Repack the map GT from per-token python objects (navsim_map_gt.py) into flat, memory-mappable arrays.
+
+Verbatim from resmap_navsim/tools/pack_map_gt.py, with explicit --src / --dst. The pickle form unpickles into
+millions of small numpy arrays that every dataloader worker copies (copy-on-write breaks on refcounts); the .npz is a
+handful of large arrays that workers share as one read-only mapping. Rings are contiguous; a token's rings are one
+slice, and area classes carry a polygon id so exterior + holes regroup into Polygon(shell, holes).
+
+    python tools/navsim/pack_map_gt.py --src .../navtrain.pkl --dst .../navtrain.npz
+"""
+import argparse
+import os
+import pickle
+
+import numpy as np
+
+
+def pack(src, dst):
+    with open(src, 'rb') as fh:
+        data = pickle.load(fh)
+    meta, gt = data['meta'], data['gt']
+    classes = list(meta['classes'])
+    area = set(meta.get('area_classes', ()))
+    cls_id = {c: i for i, c in enumerate(classes)}
+
+    tokens = sorted(gt)
+    coords, ring_len, ring_cls, ring_poly, tok_off = [], [], [], [], [0]
+    for tok in tokens:
+        g = gt[tok]
+        poly_counter = 0
+        for c in classes:
+            for item in g.get(c, []):
+                # area classes: item is [exterior, *holes]; line classes: (N, 2)
+                rings = item if c in area else [item]
+                for r in rings:
+                    r = np.asarray(r, dtype=np.float32).reshape(-1, 2)
+                    if len(r) < 2:
+                        continue
+                    coords.append(r)
+                    ring_len.append(len(r))
+                    ring_cls.append(cls_id[c])
+                    ring_poly.append(poly_counter)
+                poly_counter += 1
+        tok_off.append(len(ring_len))
+
+    out = dict(
+        coords=np.concatenate(coords, 0) if coords else np.zeros((0, 2), np.float32),
+        ring_off=np.concatenate([[0], np.cumsum(ring_len)]).astype(np.int64),
+        ring_cls=np.asarray(ring_cls, np.int8),
+        ring_poly=np.asarray(ring_poly, np.int32),
+        tok_off=np.asarray(tok_off, np.int64),
+        tokens=np.asarray(tokens, dtype='S32'),
+        classes=np.asarray(classes, dtype='S16'),
+        area_classes=np.asarray(sorted(area), dtype='S16'),
+        roi_size=np.asarray(meta['roi_size'], np.float64),
+        roi_center=np.asarray(meta['roi_center'], np.float64),
+    )
+    np.savez(dst, **out)
+    print(f'{os.path.basename(dst)}: {len(tokens):,} tokens, {len(ring_len):,} rings, {len(out["coords"]):,} points, '
+          f'{os.path.getsize(dst) / 2 ** 30:.2f} GiB')
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--src', required=True, help='navsim_map_gt.py output (.pkl)')
+    ap.add_argument('--dst', required=True, help='packed output (.npz)')
+    a = ap.parse_args()
+    pack(a.src, a.dst)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/navsim/patch_mmcv_for_torch2.py b/tools/navsim/patch_mmcv_for_torch2.py
new file mode 100644
index 0000000..9ca34c5
--- /dev/null
+++ b/tools/navsim/patch_mmcv_for_torch2.py
@@ -0,0 +1,60 @@
+"""Make mmcv-full 1.7.2 work with torch >= 2.1.
+
+Copied from yyongjae/bevfusion (navsim-100x100-cache). Older stacks pin torch 1.x, which has no sm_120 kernels, so on
+Blackwell cards (RTX 5090) the stack has to move to cu128 / torch 2.8.  mmcv
+1.7.2 is the newest 1.x and builds fine from source against it, but two of its
+DataParallel helpers still use torch APIs that 2.x changed.  Both edits are
+in site-packages, so re-run this after any mmcv reinstall.
+
+    python tools/navsim/patch_mmcv_for_torch2.py
+
+The script is idempotent and reports what it changed.
+"""
+
+import os
+import sys
+
+import mmcv
+
+PATCHES = [
+    (
+        os.path.join("parallel", "_functions.py"),
+        "            streams = [_get_stream(device) for device in target_gpus]",
+        "            # torch>=2.0 takes a torch.device here, mmcv 1.x passes an int.\n"
+        "            streams = [_get_stream(torch.device('cuda', device))\n"
+        "                       for device in target_gpus]",
+    ),
+    (
+        os.path.join("parallel", "distributed.py"),
+        "        module_to_run = self._replicated_tensor_module if \\\n"
+        "            self._use_replicated_tensor_module else self.module",
+        "        # torch>=2.1 dropped the replicated-tensor DDP path together with\n"
+        "        # these two attributes; fall back to the plain module when absent.\n"
+        "        if getattr(self, '_use_replicated_tensor_module', False):\n"
+        "            module_to_run = self._replicated_tensor_module\n"
+        "        else:\n"
+        "            module_to_run = self.module",
+    ),
+]
+
+
+def main() -> int:
+    root = os.path.dirname(mmcv.__file__)
+    print(f"mmcv {mmcv.__version__} at {root}")
+    failed = False
+    for rel, old, new in PATCHES:
+        path = os.path.join(root, rel)
+        source = open(path).read()
+        if new in source:
+            print(f"  already patched: {rel}")
+        elif source.count(old) == 1:
+            open(path, "w").write(source.replace(old, new, 1))
+            print(f"  patched:         {rel}")
+        else:
+            print(f"  FAILED, pattern not found ({source.count(old)} matches): {rel}")
+            failed = True
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
