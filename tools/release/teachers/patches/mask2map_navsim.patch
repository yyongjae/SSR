 from mmcv.runner.hooks.hook import HOOKS, Hook
+from torch.nn.modules.batchnorm import _BatchNorm
 from projects.mmdet3d_plugin.models.utils import run_time
 
 
+@HOOKS.register_module(force=True)
+class FreezeBNHook(Hook):
+    """Keep every BatchNorm in eval mode while training: running statistics stay fixed (weight/bias still train),
+    so the network is trained with exactly the normalisation it is evaluated and cached with.
+
+    Why (NAVSIM front64 Mask2Map, LSS): after a few epochs the seg head relies on the per-batch statistics of the
+    last BEV BatchNorm (transformer.encoder.downsample.7).  At epoch 9 the same val frames scored road IoU 0.74 with
+    batch statistics but 0.41 in eval mode (road over-predicted 1.8x); re-estimating the running statistics (precise
+    BN, even on the val batches themselves) did not close the gap, a short fine-tune with this hook did (epoch 12:
+    eval-mode road 0.48 -> 0.78 after 300 iterations).  The image backbone's BNs are frozen already (norm_eval).
+    The gap is a high-lr effect: by epochs 15/18 of the cosine schedule it had closed by itself.
+    """
+
+    def __init__(self):
+        self._logged = False
+
+    def before_train_iter(self, runner):
+        n = 0
+        for m in runner.model.modules():
+            if isinstance(m, _BatchNorm):
+                m.eval()
+                n += 1
+        if not self._logged:
+            runner.logger.info(f'FreezeBNHook: {n} BatchNorm layers kept in eval mode')
+            self._logged = True
+
+
 @HOOKS.register_module()
 class TransferWeight(Hook):
     
