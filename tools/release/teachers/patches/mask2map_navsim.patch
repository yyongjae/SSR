@@ -0,0 +1,143 @@
+"""NAVSIM loading steps for the Mask2Map port.
+
+LoadNavsimMultiViewImages
+    Reads the NAVSIM 1920x1080 camera JPEGs and resizes them to the network size the way resmap_navsim's offline
+    mirror was made (tools/resize_navsim_images.py: PIL draft decode at 1/2 DCT scale, then LANCZOS to 800x450),
+    so no 54 GiB mirror is needed.  A pre-resized mirror (sensor_root) is read as is.  As Mask2Map's
+    RandomScaleImageMultiViewImage does, the intrinsics stay those of the original frame and the resize goes into
+    `img_aug_matrix` and is pre-multiplied into `lidar2img`.
+    undistort=True additionally remaps each image to the ideal pinhole camera with the same (scaled) intrinsics, so
+    the pinhole geometry every downstream step assumes (LSS lift, depth GT, PV GT) is exact.  NAVSIM's lenses have
+    k1 = -0.356, k2 = 0.17: without it a feature at the image edge is lifted along a ray 4.2 deg off its true one
+    (0.6 deg at u = 600 of 800).  The remap keeps the full output valid (it reads source x 46..754 of 800, i.e.
+    drops the outer periphery) and costs ~1 ms per image.  resmap_navsim does not undistort (undistort=False).
+LoadNavsimPointsFromFile
+    MergedPointCloud .pcd (already in the ego frame, lidar2ego = I) -> LiDARPoints (N, 5).  Training only: the
+    points supervise the LSS depth, the model never sees them.
+NavsimPointToMultiViewDepth
+    Mask2Map's CustomPointToMultiViewDepth with the ego -> image matrix taken directly (float64) instead of the
+    float32 global chain, which loses ~0.25 m at UTM northings of ~4e6 m.
+"""
+import mmcv
+import numpy as np
+import torch
+from mmdet.datasets.builder import PIPELINES
+from mmdet3d.core.points import get_points_type
+from PIL import Image
+
+from ..navsim_map_utils import load_pcd_points
+from .loading import CustomPointToMultiViewDepth
+
+
+@PIPELINES.register_module()
+class LoadNavsimMultiViewImages(object):
+    """Load the cameras of `results['img_filename']`, resized to `img_size` = (W, H) (default 800 x 450).
+
+    Args:
+        img_size (tuple): network image size (W, H) before padding.
+        calib_size (tuple): (W, H) the intrinsics in the infos are calibrated at (NAVSIM: 1920 x 1080).
+        to_float32 (bool): output float32 BGR (Mask2Map's LoadMultiViewImageFromFiles convention).
+    """
+
+    def __init__(self, img_size=(800, 450), calib_size=(1920, 1080), to_float32=True, undistort=False):
+        self.img_size = tuple(int(v) for v in img_size)
+        self.calib_size = tuple(int(v) for v in calib_size)
+        self.to_float32 = to_float32
+        self.undistort = undistort
+        self._maps = {}
+
+    def _undistort(self, img, K, dist):
+        import cv2
+        sx = self.img_size[0] / self.calib_size[0]
+        sy = self.img_size[1] / self.calib_size[1]
+        Ks = np.diag([sx, sy, 1.0]) @ np.asarray(K, dtype=np.float64)[:3, :3]
+        d = np.asarray(dist, dtype=np.float64).reshape(-1)
+        key = (Ks.tobytes(), d.tobytes())
+        if key not in self._maps:
+            self._maps[key] = cv2.initUndistortRectifyMap(Ks, d, None, Ks, self.img_size, cv2.CV_32FC1)
+        m1, m2 = self._maps[key]
+        return cv2.remap(img, m1, m2, interpolation=cv2.INTER_LINEAR, borderMode=cv2.BORDER_CONSTANT)
+
+    def _load(self, path):
+        with Image.open(path) as im:
+            if im.size != self.img_size:
+                if im.size != self.calib_size:
+                    raise ValueError(f'{path}: {im.size} is neither the calibration size {self.calib_size} nor the '
+                                     f'network size {self.img_size}; a cropped mirror needs a shifted principal point')
+                im.draft('RGB', self.img_size)  # libjpeg-level 1/2 scale decode (960 x 540), as resmap_navsim
+                im = im.convert('RGB').resize(self.img_size, Image.Resampling.LANCZOS)
+            else:
+                im = im.convert('RGB')
+            img = np.asarray(im)[:, :, ::-1]  # RGB -> BGR (mmcv.imread convention)
+        return np.ascontiguousarray(img, dtype=np.float32 if self.to_float32 else np.uint8)
+
+    def __call__(self, results):
+        filename = results['img_filename']
+        imgs = [self._load(p) for p in filename]
+        if self.undistort:
+            imgs = [self._undistort(img, K, d)
+                    for img, K, d in zip(imgs, results['camera_intrinsics'], results['cam_distortion'])]
+        sx = self.img_size[0] / self.calib_size[0]
+        sy = self.img_size[1] / self.calib_size[1]
+        scale = np.eye(4)
+        scale[0, 0], scale[1, 1] = sx, sy
+        results['filename'] = filename
+        results['img'] = imgs
+        results['img_shape'] = [img.shape for img in imgs]
+        results['ori_shape'] = [img.shape for img in imgs]
+        results['pad_shape'] = [img.shape for img in imgs]
+        results['scale_factor'] = 1.0
+        results['img_norm_cfg'] = dict(mean=np.zeros(3, dtype=np.float32), std=np.ones(3, dtype=np.float32),
+                                       to_rgb=False)
+        results['lidar2img'] = [scale @ l2i for l2i in results['lidar2img']]
+        results['img_aug_matrix'] = [scale.copy() for _ in results['lidar2img']]
+        return results
+
+    def __repr__(self):
+        return (f'{self.__class__.__name__}(img_size={self.img_size}, calib_size={self.calib_size}, '
+                f'undistort={self.undistort})')
+
+
+@PIPELINES.register_module()
+class LoadNavsimPointsFromFile(object):
+    """MergedPointCloud .pcd -> results['points'] (LiDARPoints, (N, use_dim)), in the ego (= lidar) frame."""
+
+    def __init__(self, coord_type='LIDAR', load_dim=5, use_dim=5):
+        self.coord_type = coord_type
+        self.load_dim = load_dim
+        self.use_dim = use_dim if isinstance(use_dim, (list, tuple)) else list(range(use_dim))
+
+    def __call__(self, results):
+        path = results['pts_filename']
+        assert path is not None, f'no lidar_path for token {results.get("sample_idx")}'
+        pts = load_pcd_points(path, self.load_dim)[:, self.use_dim]
+        points_class = get_points_type(self.coord_type)
+        results['points'] = points_class(pts, points_dim=pts.shape[-1], attribute_dims=None)
+        return results
+
+    def __repr__(self):
+        return f'{self.__class__.__name__}(load_dim={self.load_dim}, use_dim={self.use_dim})'
+
+
+@PIPELINES.register_module()
+class NavsimPointToMultiViewDepth(CustomPointToMultiViewDepth):
+    """Sparse per-pixel depth GT (nearest LiDAR return per pixel, depth in grid_config['depth'][:2]).
+
+    Uses results['lidar2img'] (K @ ego2cam with the pipeline resize already applied), in float64.  Equivalent to
+    Mask2Map's CustomPointToMultiViewDepth when lidar2ego = I, minus its float32 UTM round trip.
+    """
+
+    def __call__(self, results):
+        pts = results['points'].tensor[:, :3].numpy().astype(np.float64)
+        imgs = results['img']
+        depth_maps = []
+        for cid, l2i in enumerate(results['lidar2img']):
+            l2i = np.asarray(l2i, dtype=np.float64)
+            p = pts @ l2i[:3, :3].T + l2i[:3, 3]
+            z = p[:, 2]
+            front = z > 1e-3
+            uvd = np.stack([p[front, 0] / z[front], p[front, 1] / z[front], z[front]], 1)
+            h, w = imgs[cid].shape[:2]
+            depth_maps.append(self.points2depthmap(torch.from_numpy(uvd).float(), h, w))
+        results['gt_depth'] = torch.stack(depth_maps)
+        return results
