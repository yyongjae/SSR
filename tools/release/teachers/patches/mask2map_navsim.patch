diff --git a/projects/configs/mask2map_navsim/M2M_navsim_front64_r50_sem_18ep.py b/projects/configs/mask2map_navsim/M2M_navsim_front64_r50_sem_18ep.py
new file mode 100644
index 0000000..21e1785
--- /dev/null
+++ b/projects/configs/mask2map_navsim/M2M_navsim_front64_r50_sem_18ep.py
@@ -0,0 +1,329 @@
+# Mask2Map phase 1 on NAVSIM, trained as a drop-in replacement for the ReSMap front64 stage-1 map teacher:
+# BEV semantic segmentation only (semantic_only, as Mask2Map_b2d 547c0d3): seg_head on the LSS BEV with ReSMap's
+# focal x10 + dice x1, + LiDAR depth (training only) + PV seg.  The instance branch (pixel decoder, Mask2Former
+# queries, matching) is built but not run, so its loss_segm_* / assigner settings are unused.
+#
+# Matches resmap_navsim plugin/configs/resmap_nav_rideflux_front64/resmap_nav_stage1.py:
+#   cameras   CAM_L0, CAM_F0, CAM_R0; 1920x1080 -> 800x450 (PIL draft + LANCZOS, as ReSMap's mirror) -> pad to 480x800
+#   ROI       x [0, 64] m forward, y [-32, 32] m left (roi_size 64 x 64, roi_center (32, 0)); pc_range [0,-32,-3,64,32,5]
+#   BEV       100 x 100 at 0.64 m, 256 ch (LSS 200 x 200 at 0.32 m, stride-2 conv); rows = y from -32 m, cols = x
+#             from 0 m (ReSMap's cache layout is this flipped on rows; tools/navsim/cache_teacher_m2m.py flips it)
+#   seg       4 x 200 x 200 at 0.32 m (one nearest-x2 up block, ReSMap MapSegHead layout); road / walkway /
+#             centerline / crosswalk, multi-label sigmoid, GT rasterised exactly as ReSMap
+#   splits    train = navtrain logs in train_logs (978 logs, 126,032 frames); val = val_logs (214 logs, 26,463 frames)
+#   schedule  18 epochs, val every 3 epochs, pick the checkpoint by val mIoU (ReSMap's eval interval / length)
+# Mask2Map's own recipe is kept for the optimisation: AdamW lr 6e-4 x (global batch / 32), backbone x0.1,
+# weight decay 0.01, 500 warmup iters, cosine to 1e-3, grad clip 35, fp16 (loss scale 512); R50 from
+# sparsebev_resnet.pth with ImageNet RGB normalisation; PhotoMetricDistortion + GridMask(0.7).
+# LSS depth bins [1, 72) m in 0.5 m (142 bins) reach the far ROI corner (71.6 m); the nuScenes [1, 35) would leave
+# 35-64 m without depth supervision.
+#
+# Data: tools/navsim/prepare_data.sh (infos + map GT); launch: tools/navsim/train_front64.sh.
+_base_ = ["../_base_/default_runtime.py"]
+
+plugin = True
+plugin_dir = "projects/mmdet3d_plugin/"
+
+navsim_root = "/workspace/navsim_workspace/mask2map/"  # infos/, map_gt_navsim_front64x64/, ckpts/
+log_split_yaml = "/workspace/navsim/navsim/planning/script/config/training/default_train_val_test_log_split.yaml"
+
+point_cloud_range = [0.0, -32.0, -3.0, 64.0, 32.0, 5.0]  # true ego metres (rear axle), as ReSMap's pc_range
+voxel_size = [0.32, 0.32, 8.0]  # LSS grid 200 (x) x 200 (y) x 1 (z); downsample 2 -> BEV 100 x 100 at 0.64 m
+dbound = [1.0, 72.0, 0.5]
+roi_size = (64.0, 64.0)
+roi_center = (32.0, 0.0)
+canvas_size = (200, 200)  # (W forward, H lateral), 0.32 m
+
+grid_config = {
+    "x": [0.0, 64.0, 0.32],  # unused by LSSTransform (it builds its grid from pc_range / voxel_size)
+    "y": [-32.0, 32.0, 0.32],  # unused
+    "z": [-3.0, 5.0, 8.0],  # unused
+    "depth": [1.0, 72.0, 0.5],  # used: depth GT range and bins
+}
+
+img_norm_cfg = dict(mean=[123.675, 116.28, 103.53], std=[58.395, 57.12, 57.375], to_rgb=True)
+
+# detection classes of the nuScenes base dataset class; unused
+class_names = ["car", "truck", "construction_vehicle", "bus", "trailer", "barrier", "motorcycle", "bicycle",
+               "pedestrian", "traffic_cone"]
+map_classes = ["road", "walkway", "centerline", "crosswalk"]  # ReSMap front64 cat2id order
+camera_names = ["CAM_L0", "CAM_F0", "CAM_R0"]
+num_vec = 100  # instance branch only (unused here)
+fixed_ptsnum_per_gt_line = 20
+fixed_ptsnum_per_pred_line = 20
+eval_use_same_gt_sample_num_flag = True
+num_map_classes = len(map_classes)
+
+input_modality = dict(use_lidar=False, use_camera=True, use_radar=False, use_map=False, use_external=True)
+
+_dim_ = 256
+_pos_dim_ = _dim_ // 2
+_ffn_dim_ = _dim_ * 2
+_num_levels_ = 1
+bev_h_ = 100
+bev_w_ = 100
+queue_length = 1  # single frame
+
+dn_enabled = False
+
+aux_seg_cfg = dict(
+    use_aux_seg=True,
+    bev_seg=True,  # 4-class BEV seg on the LSS BEV (the tensor to cache)
+    pv_seg=True,  # 4-class PV seg from the BEV GT by inverse perspective mapping (navsim_map_utils.pv_ground_labels)
+    seg_classes=num_map_classes,
+    feat_down_sample=32,
+    pv_thickness=1,
+)
+
+model = dict(
+    type="Mask2Map",
+    use_grid_mask=True,
+    video_test_mode=False,
+    pretrained=dict(img=navsim_root + "ckpts/sparsebev_resnet.pth"),
+    img_backbone=dict(
+        type="ResNet",
+        depth=50,
+        num_stages=4,
+        out_indices=(3,),
+        frozen_stages=1,
+        norm_cfg=dict(type="BN", requires_grad=False),
+        norm_eval=True,
+        style="pytorch",
+    ),
+    img_neck=dict(
+        type="FPN",
+        in_channels=[2048],
+        out_channels=_dim_,
+        start_level=0,
+        add_extra_convs="on_output",
+        num_outs=_num_levels_,
+        relu_before_extra_convs=True,
+    ),
+    pts_bbox_head=dict(
+        type="Mask2MapHead_1Phase",
+        semantic_only=True,
+        seg_upsample=1,  # BEV 100 x 100 -> seg 200 x 200
+        seg_score_thr=0.4,  # ReSMap's eval rule
+        bev_h=bev_h_,
+        bev_w=bev_w_,
+        num_vec_one2one=num_vec,
+        num_pts_per_vec=fixed_ptsnum_per_pred_line,
+        num_pts_per_gt_vec=fixed_ptsnum_per_gt_line,
+        dir_interval=1,
+        num_classes=num_map_classes,
+        in_channels=_dim_,
+        sync_cls_avg_factor=True,
+        with_box_refine=True,
+        as_two_stage=False,
+        code_size=2,
+        dn_enabled=dn_enabled,
+        dn_weight=1,
+        code_weights=[1.0, 1.0, 1.0, 1.0],
+        aux_seg=aux_seg_cfg,
+        pc_range=point_cloud_range,
+        transformer=dict(
+            type="Mask2Map_Transformer_1Phase",
+            num_cams=len(camera_names),
+            rotate_prev_bev=True,
+            use_can_bus=True,
+            dn_enabled=dn_enabled,
+            dn_group_num=5,
+            dn_noise_scale=0.01,
+            mask_noise_scale=0.2,
+            num_vec_one2one=num_vec,
+            embed_dims=_dim_,
+            num_classes=num_map_classes,  # the transformer's defaults are the 3 nuScenes classes
+            bev_h=bev_h_,  # ... and the nuScenes 200 x 100 / 60 x 30 m
+            bev_w=bev_w_,
+            patch_size=[point_cloud_range[4] - point_cloud_range[1], point_cloud_range[3] - point_cloud_range[0]],
+            bev_encoder=None,
+            bev_neck=dict(
+                type="MSDeformAttnPixelDecoder",
+                num_outs=4,
+                in_channels=[256, 256, 256, 256],
+                strides=[1, 2, 4, 8],
+                norm_cfg=dict(type="GN", num_groups=32),
+                act_cfg=dict(type="ReLU"),
+                encoder=dict(
+                    num_layers=6,
+                    layer_cfg=dict(
+                        self_attn_cfg=dict(embed_dims=256, num_heads=8, num_levels=3, num_points=4, dropout=0.0,
+                                           batch_first=True),
+                        ffn_cfg=dict(embed_dims=256, feedforward_channels=1024, num_fcs=2, ffn_drop=0.0,
+                                     act_cfg=dict(type="ReLU", inplace=True)),
+                    ),
+                ),
+                positional_encoding=dict(num_feats=128, normalize=True),
+            ),
+            encoder=dict(
+                type="LSSTransform",
+                in_channels=_dim_,
+                out_channels=_dim_,
+                feat_down_sample=32,
+                pc_range=point_cloud_range,
+                voxel_size=voxel_size,
+                dbound=dbound,
+                downsample=2,
+                loss_depth_weight=3.0,
+                depthnet_cfg=dict(use_dcn=False, with_cp=False, aspp_mid_channels=96),
+                grid_config=grid_config,
+            ),
+            segm_decoder=dict(
+                type="Mask2FormerTransformerDecoder",
+                return_intermediate=True,
+                num_layers=3,
+                layer_cfg=dict(
+                    self_attn_cfg=dict(embed_dims=256, num_heads=8, dropout=0.0, batch_first=True),
+                    cross_attn_cfg=dict(embed_dims=256, num_heads=8, dropout=0.0, batch_first=True),
+                    ffn_cfg=dict(embed_dims=256, feedforward_channels=2048, num_fcs=2, ffn_drop=0.0,
+                                 act_cfg=dict(type="ReLU", inplace=True)),
+                ),
+                init_cfg=None,
+            ),
+        ),
+        loss_cls=dict(type="FocalLoss", use_sigmoid=True, gamma=2.0, alpha=0.25, loss_weight=2.0),  # unused
+        loss_bbox=dict(type="L1Loss", loss_weight=0.0),  # unused
+        loss_iou=dict(type="GIoULoss", loss_weight=0.0),  # unused
+        loss_seg=dict(type="ReSMapSegLoss", focal_weight=10.0, dice_weight=1.0),  # ReSMap stage 1
+        loss_pv_seg=dict(type="SimpleLoss", pos_weight=1.0, loss_weight=2.0),
+        loss_segm_cls=dict(type="CrossEntropyLoss", use_sigmoid=False, loss_weight=2.0, reduction="mean",
+                           class_weight=[1.0] * len(map_classes) + [0.1]),  # unused
+        loss_segm_mask=dict(type="CrossEntropyLoss", use_sigmoid=True, reduction="mean", loss_weight=5.0),  # unused
+        loss_segm_dice=dict(type="DiceLoss", use_sigmoid=True, activate=True, reduction="mean", naive_dice=True,
+                            eps=1.0, loss_weight=5.0),  # unused
+    ),
+    train_cfg=dict(
+        pts=dict(
+            grid_size=[512, 512, 1],
+            voxel_size=voxel_size,
+            point_cloud_range=point_cloud_range,
+            out_size_factor=4,
+            assigner=dict(
+                type="MapTRAssigner",
+                cls_cost=dict(type="FocalLossCost", weight=2.0),
+                reg_cost=dict(type="BBoxL1Cost", weight=0.0, box_format="xywh"),
+                iou_cost=dict(type="IoUCost", iou_mode="giou", weight=0.0),
+                pts_cost=dict(type="OrderedPtsL1Cost", weight=5),
+                pc_range=point_cloud_range,
+            ),
+            assigner_segm=dict(
+                type="MaskHungarianAssigner",
+                cls_cost=dict(type="ClassificationCost", weight=2.0),
+                mask_cost=dict(type="CrossEntropyLossCost", weight=5.0, use_sigmoid=True),
+                dice_cost=dict(type="DiceCost", weight=5.0, pred_act=True, eps=1.0),
+            ),
+        )
+    ),
+)
+
+dataset_type = "NavsimOfflineMapDataset"
+file_client_args = dict(backend="disk")
+
+# CustomCollect3D's default meta_keys also copy gt_depth (3 x 480 x 800 float32) into img_metas; leave it out
