new file mode 100755
index 0000000..7642b4d
--- /dev/null
+++ b/tools/navsim/prepare_data.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# Build the NAVSIM data the Mask2Map front64 config reads (CPU only):
+#   $OUT/infos/navsim_map_infos_{navtrain,navtest}.pkl           tools/navsim/create_navsim_infos.py
+#   $OUT/map_gt_navsim_front64x64/{navtrain,navtest}.{pkl,npz}   tools/navsim/navsim_map_gt.py + pack_map_gt.py
+# Camera images are resized on the fly (LoadNavsimMultiViewImages), so no image mirror is needed.
+#
+#   bash tools/navsim/prepare_data.sh
+#
+# NAVSIM_DL: the NAVSIM download root ({trainval,test}_{navsim_logs,sensor_blobs}/, maps/); NAVSIM_REPO: the navsim
+# checkout holding the scene filters; GT_PY: a python with nuplan-devkit (read-only use); PY: the training env.
+set -euo pipefail
+
+REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+OUT=${OUT:-/workspace/navsim_workspace/mask2map}
+NAVSIM_DL=${NAVSIM_DL:-/workspace/navsim/download}
+NAVSIM_REPO=${NAVSIM_REPO:-/workspace/navsim}
+PY=${PY:-/venv/m2m/bin/python}
+GT_PY=${GT_PY:-/venv/theme/bin/python}
+WORKERS=${WORKERS:-32}
+export OPENBLAS_CORETYPE=SkylakeX
+SF=$NAVSIM_REPO/navsim/planning/script/config/common/train_test_split/scene_filter
+G=$OUT/map_gt_navsim_front64x64
+mkdir -p "$OUT/infos" "$G"
+cd "$OUT"  # never run python from inside the data trees; scripts are passed by path with -I
+
+declare -A SPLIT=([navtrain]=trainval [navtest]=test)
+for f in navtrain navtest; do
+  s=${SPLIT[$f]}
+  "$PY" -I "$REPO/tools/navsim/create_navsim_infos.py" --filter "$f" --scene-filter-dir "$SF" \
+      --logs-root "$NAVSIM_DL/${s}_navsim_logs/$s" --blobs-root "$NAVSIM_DL/${s}_sensor_blobs/$s" \
+      --out "$OUT/infos/navsim_map_infos_$f.pkl" --workers 24
+  # front64 box: x [0, 64] m, y [-32, 32] m; radius 72 m reaches its far corner (resmap derive_front64_config.py)
+  "$GT_PY" -I "$REPO/tools/navsim/navsim_map_gt.py" --infos "$OUT/infos/navsim_map_infos_$f.pkl" --out "$G/$f.pkl" \
+      --map-root "$NAVSIM_DL/maps" --roi-x 64 --roi-y 64 --roi-cx 32 --roi-cy 0 --radius 72 --workers "$WORKERS"
+  "$PY" -I "$REPO/tools/navsim/pack_map_gt.py" --src "$G/$f.pkl" --dst "$G/$f.npz"
+done
+echo "[prepare_data] done: $OUT"
diff --git a/tools/navsim/setup_env.sh b/tools/navsim/setup_env.sh
new file mode 100755
index 0000000..f6fe621
--- /dev/null
+++ b/tools/navsim/setup_env.sh
@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+# Build the Mask2Map-NAVSIM env for RTX 5090 (sm_120): python 3.9, torch 2.8.0+cu128, mmcv-full 1.7.2 built from
+# source, mmdet 2.28.2, mmseg 0.30.0, and the vendored mmdetection3d (0.17.2, patched for torch 2.x and mmcv 1.7).
+# The recipe follows yyongjae/bevfusion@navsim-100x100-cache setup_fix.md, which was verified on RTX 5090.
+#
+#   bash tools/navsim/setup_env.sh base   # conda env, torch, mmcv-full (about 10-20 min of nvcc), mmdet, mmseg, deps
+#   bash tools/navsim/setup_env.sh repo   # vendored mmdet3d CUDA ops (bev_pool, voxel, ...) as an editable install
+#   bash tools/navsim/setup_env.sh check  # imports + the CUDA ops on one GPU
+#   bash tools/navsim/setup_env.sh all
+#
+# ENV (default /venv/m2m), CONDA, CUDA_HOME, MAX_JOBS and TORCH_CUDA_ARCH_LIST can be overridden.
+# Never point ENV at an env another job is using.
+set -euo pipefail
+
+STAGE=${1:-all}
+ENV=${ENV:-/venv/m2m}
+CONDA=${CONDA:-/opt/miniforge3/bin/conda}
+REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+
+export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.8}
+export PATH=$CUDA_HOME/bin:$PATH
+export CC=${CC:-/usr/bin/gcc-13} CXX=${CXX:-/usr/bin/g++-13}
+export TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-12.0}
+export MAX_JOBS=${MAX_JOBS:-32}
+# numpy 1.23's bundled OpenBLAS misdetects some Xeons (e.g. 8469C) and silently returns wrong linear algebra.
+export OPENBLAS_CORETYPE=${OPENBLAS_CORETYPE:-SkylakeX}
+
+PY=$ENV/bin/python
+PIP="$PY -m pip"
+step() { echo "[$(TZ=Asia/Seoul date '+%F %T KST')] $*"; }
+
+stage_base() {
+  if [ ! -x "$PY" ]; then
+    step "conda create $ENV (python 3.9, ninja)"
+    "$CONDA" create -y -p "$ENV" -c conda-forge --override-channels python=3.9 ninja
+  fi
+  $PIP install "pip<25.3"  # the repo stage needs the legacy setup.py-develop editable install
+  step "torch 2.8.0 + torchvision 0.23.0 (cu128)"
+  $PIP install torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu128
+  # setuptools must be pinned after torch and before any extension build.
+  $PIP install setuptools==59.5.0 wheel==0.37.1 Pillow==9.5.0 tqdm numpy==1.23.5
+
+  if ! $PY -c "import mmcv, mmcv.ops; assert mmcv.__version__ == '1.7.2'" 2>/dev/null; then
+    step "mmcv-full 1.7.2 from source (TORCH_CUDA_ARCH_LIST=$TORCH_CUDA_ARCH_LIST, MAX_JOBS=$MAX_JOBS)"
+    MMCV_WITH_OPS=1 FORCE_CUDA=1 $PIP install --no-build-isolation --no-binary mmcv-full "mmcv-full==1.7.2"
+  fi
+
+  step "mmdet, mmseg and the Mask2Map runtime deps"
+  $PIP install mmdet==2.28.2 mmsegmentation==0.30.0 timm==0.9.16 numba==0.56.4 "nuscenes-devkit==1.1.11" \
+      "shapely==1.8.5.post1" pyquaternion terminaltables prettytable descartes pycocotools tensorboard einops \
+      trimesh pandas scikit-image matplotlib
+  # mmdet3d 0.17.2 imports lyft_eval at module level; the SDK's own install_requires pin a dev toolchain.
+  $PIP install --no-deps lyft_dataset_sdk==0.0.8
+  $PIP install cachetools fire plotly scikit-learn
+  # The builds above pull numpy 2.x, opencv 5 and yapf 0.43; numba 0.56 needs numpy < 1.24 and mmcv 1.x needs yapf 0.40.
+  $PIP install numpy==1.23.5 opencv-python==4.9.0.80 yapf==0.40.1 setuptools==59.5.0
+
+  step "mmcv torch>=2.1 patch"
+  $PY "$REPO/tools/navsim/patch_mmcv_for_torch2.py"
+}
+
+stage_repo() {
+  step "vendored mmdetection3d ops (editable, no deps)"
+  (cd "$REPO/mmdetection3d" && FORCE_CUDA=1 $PIP install --no-build-isolation --no-deps -e .)
+}
+
+stage_check() {
+  step "import + CUDA op check (first free GPU only; set CUDA_VISIBLE_DEVICES to choose)"
+  (cd "$REPO" && PYTHONPATH="$REPO:${PYTHONPATH:-}" $PY - <<'EOF'
+import torch, mmcv, mmdet, mmseg, mmdet3d
+from mmcv.ops import MultiScaleDeformableAttention, nms
+from mmdet3d.ops import bev_pool
+print('torch', torch.__version__, 'cuda', torch.version.cuda, 'arch', torch.cuda.get_arch_list())
+print('mmcv', mmcv.__version__, 'mmdet', mmdet.__version__, 'mmseg', mmseg.__version__, 'mmdet3d', mmdet3d.__version__)
+import projects.mmdet3d_plugin  # registers the plugin modules
+assert torch.cuda.is_available()
+b = torch.rand(64, 4, device='cuda'); b[:, 2:] += b[:, :2]
+keep = nms(b, torch.rand(64, device='cuda'), 0.5)[1]
+assert 0 < keep.numel() <= 64
+print('mmcv nms on GPU:', keep.numel(), 'kept')
+feats = torch.rand(100, 8, device='cuda')
+coords = torch.stack([torch.randint(0, 10, (100,)), torch.randint(0, 10, (100,)), torch.zeros(100, dtype=torch.long),
+                      torch.zeros(100, dtype=torch.long)], 1).int().cuda()
+out = bev_pool(feats, coords, 1, 1, 10, 10)
+assert tuple(out.shape) == (1, 8, 1, 10, 10) and torch.allclose(out.sum(), feats.sum(), rtol=1e-4)
+print('bev_pool', tuple(out.shape), 'sum preserved')
+EOF
+  )
+}
+
+case "$STAGE" in
+  base) stage_base ;;
+  repo) stage_repo ;;
+  check) stage_check ;;
+  all) stage_base; stage_repo; stage_check ;;
+  *) echo "usage: $0 {base|repo|check|all}" >&2; exit 2 ;;
+esac
+step "done: $STAGE"
