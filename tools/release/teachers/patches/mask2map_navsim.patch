+"""NAVSIM (openscene-v1.1) dataset for Mask2Map, set up as the ReSMap front64 stage-1 teacher.
+
+Everything that defines the data -- frames, splits, cameras, intrinsics handling, ROI, map classes, map GT and its
+raster -- follows resmap_navsim (plugin/datasets/navsim_dataset.py, pipelines/rasterize.py and the
+resmap_nav_rideflux_front64 stage-1 config), so this model sees the same inputs and targets as the ReSMap teacher:
+
+* infos: tools/navsim/create_navsim_infos.py (navtrain 152,495 frames; navtest 71,460).
+* log_split 'train' (978 navtrain logs, 126,032 frames) for training and 'val' (214 logs, 26,463 frames) for
+  validation, from NAVSIM's default_train_val_test_log_split.yaml.  navtest is a separate run.
+* cameras CAM_L0, CAM_F0, CAM_R0 in that order; intrinsics calibrated at 1920x1080 (cy = 560, distortion ignored,
+  as in ReSMap and BEVFusion); ego == lidar (lidar2ego = I).
+* ROI x in [0, 64] m forward, y in [-32, 32] m (roi_size 64 x 64, roi_center (32, 0)); pc_range
+  [0, -32, -3, 64, 32, 5] in true ego metres for the LSS grid.
+* classes road / walkway / centerline / crosswalk, GT from tools/navsim/navsim_map_gt.py + pack_map_gt.py,
+  rasterised to (4, 200, 200) exactly as ReSMap (navsim_map_utils.NavsimBEVRasterizer).
+
+Training is single-frame (queue_length 1) phase-1 semantic segmentation: the head's semantic_only mode reads
+`gt_seg_mask` (BEV, 4 x 200 x 200), `gt_pv_seg_mask` (PV, N x 4 x 15 x 25) and `gt_depth` (LiDAR, train only).
+evaluate() computes ReSMap's stage-1 metric (per-pixel argmax, kept if sigmoid >= 0.4, dataset-level IoU) plus a
+multi-label IoU (sigmoid >= 0.5 per class).
+"""
+import os
+from time import time
+
+import mmcv
+import numpy as np
+import torch
+from mmcv.parallel import DataContainer as DC
+from mmdet.datasets import DATASETS
+from nuscenes.eval.common.utils import Quaternion, quaternion_yaw
+
+from .navsim_map_utils import NAVSIM_MAP_CLASSES, NavsimBEVRasterizer, NavsimMapGT, pv_ground_labels
+from .nuscenes_offlinemap_dataset import CustomNuScenesOfflineLocalMapDataset
+
+DEFAULT_LOG_SPLIT_YAML = '/workspace/navsim/navsim/planning/script/config/training/default_train_val_test_log_split.yaml'
+
+
+@DATASETS.register_module()
+class NavsimOfflineMapDataset(CustomNuScenesOfflineLocalMapDataset):
+    """Args (on top of CustomNuScenesOfflineLocalMapDataset's):
+        camera_names (list[str]): cameras fed to the model, in order.
+        map_gt_file (str): packed map GT (.npz) covering every frame of ann_file.
+        log_split (str | None): 'train' | 'val' | None (every log in ann_file).
+        log_split_yaml (str): NAVSIM's default_train_val_test_log_split.yaml.
+        split_tokens_only (bool): keep only scene-filter allow-list frames (in_split_tokens).
+        token_list (str | None): optional text file (one token per line) restricting the frames, e.g. for caching.
+        sensor_root / sensor_src_root (str | None): read images from a mirror; the `sensor_src_root` prefix of every
+            img_fpath is replaced by `sensor_root` (e.g. a pre-resized 800x450 copy).
+        roi_size, roi_center: ROI-centred GT frame (must match the map GT file).
+        canvas_size (W, H), seg_thickness: BEV raster.
+        pv_ground_z, pv_supersample: PV GT (navsim_map_utils.pv_ground_labels).
+        eval_score_thr (float): ReSMap's single-label threshold.
+    """
+
+    MAPCLASSES = NAVSIM_MAP_CLASSES
+    LINE_CLASSES = ('centerline',)  # the others are areas (filled polygons)
+    CAMERA_NAMES = ('CAM_L0', 'CAM_F0', 'CAM_R0')
+
+    def __init__(self,
+                 camera_names=CAMERA_NAMES,
+                 map_gt_file=None,
+                 log_split=None,
+                 log_split_yaml=DEFAULT_LOG_SPLIT_YAML,
+                 split_tokens_only=False,
+                 token_list=None,
+                 sensor_root=None,
+                 sensor_src_root=None,
+                 roi_size=(64.0, 64.0),
+                 roi_center=(32.0, 0.0),
+                 canvas_size=(200, 200),
+                 seg_thickness=3,
+                 pv_ground_z=-0.33,
+                 pv_supersample=4,
+                 eval_score_thr=0.4,
+                 **kwargs):
+        # load_annotations() runs inside the base __init__, so everything it reads is set first
+        self.camera_names = list(camera_names)
+        self.log_split = log_split
+        self.split_tokens_only = split_tokens_only
+        self._log_allow = None
+        if log_split is not None:
+            import yaml
+            with open(log_split_yaml) as fh:
+                self._log_allow = set(yaml.safe_load(fh)[f'{log_split}_logs'])
+        self._token_allow = None
+        if token_list is not None:
+            with open(token_list) as fh:
+                self._token_allow = set(t.strip() for t in fh if t.strip())
+        self.sensor_root, self.sensor_src_root = sensor_root, sensor_src_root
+        assert (sensor_root is None) == (sensor_src_root is None), 'set both sensor_root and sensor_src_root'
+        kwargs.setdefault('filter_empty_gt', False)
+        super().__init__(**kwargs)
+        assert self.queue_length == 1, 'the NAVSIM port is single-frame (queue_length = 1)'
+        # inherited from mmdet3d NuScenesDataset for nuScenes detection eval; holds dict_keys, which cannot be pickled
+        # (a spawn-started DataLoader would fail), and nothing here uses it
+        self.eval_detection_configs = None
+
+        self.roi_size = tuple(float(v) for v in roi_size)
+        self.roi_center = tuple(float(v) for v in roi_center)
+        self.canvas_size = tuple(int(v) for v in canvas_size)
+        self.rasterizer = NavsimBEVRasterizer(self.roi_size, self.canvas_size, seg_thickness)
+        self.pv_ground_z = pv_ground_z
+        self.pv_supersample = pv_supersample
+        self.eval_score_thr = eval_score_thr
+        self.cat2label = {c: i for i, c in enumerate(self.MAPCLASSES)}
+
+        assert map_gt_file is not None, 'map_gt_file (tools/navsim/pack_map_gt.py output) is required'
+        self.map_gt = NavsimMapGT(map_gt_file, self.roi_size, self.roi_center, self.MAPCLASSES)
+        missing = sum(1 for info in self.data_infos if info['token'] not in self.map_gt)
+        print(f'[NavsimOfflineMapDataset] map GT {map_gt_file}: {len(self.map_gt.row)} tokens, '
+              f'{missing} of {len(self.data_infos)} frames missing')
+        assert missing == 0, f'{missing} frames have no map GT; regenerate it with tools/navsim/navsim_map_gt.py'
+
+    # ----------------------------------------------------------------------------------------------------------- #
+    # annotations
+    # ----------------------------------------------------------------------------------------------------------- #
+    def load_annotations(self, ann_file):
+        t0 = time()
+        infos = mmcv.load(ann_file, file_format='pkl')
+        n0 = len(infos)
+        if self._log_allow is not None:
+            infos = [s for s in infos if s['log_name'] in self._log_allow]
+        if self.split_tokens_only:
+            infos = [s for s in infos if s.get('in_split_tokens', True)]
+        if self._token_allow is not None:
+            infos = [s for s in infos if s['token'] in self._token_allow]
+        infos = infos[::self.load_interval]
+        # sample_idx / prev / next are global indices; filtering invalidates them, so renumber per scene run
+        prev_scene = None
+        for idx, s in enumerate(infos):
+            s['sample_idx'] = idx
+            s['prev'] = -1 if s['scene_name'] != prev_scene else idx - 1
+            prev_scene = s['scene_name']
+        for idx, s in enumerate(infos[:-1]):
+            s['next'] = -1 if infos[idx + 1]['scene_name'] != s['scene_name'] else idx + 1
+        if infos:
+            infos[-1]['next'] = -1
+        self.metadata = dict(version='navsim')
+        self.version = 'navsim'
+        print(f'[NavsimOfflineMapDataset] {ann_file}: log_split={self.log_split!r} '
+              f'split_tokens_only={self.split_tokens_only} -> {len(infos)} of {n0} frames ({time() - t0:.1f}s)')
+        return infos
+
+    def _set_group_flag(self):
+        self.flag = np.zeros(len(self), dtype=np.uint8)
+
+    def get_data_info(self, index):
+        info = self.data_infos[index]
+        input_dict = dict(
+            sample_idx=info['token'],
+            token=info['token'],
+            pts_filename=info['lidar_path'],
+            lidar_path=info['lidar_path'],
+            sweeps=[],
+            ego2global_translation=info['e2g_translation'],
+            ego2global_rotation=info['e2g_rotation'],
+            lidar2ego_translation=info['lidar2ego_translation'],
+            lidar2ego_rotation=info['lidar2ego_rotation'],
+            prev_idx=info['prev'],
+            next_idx=info['next'],
+            scene_token=info['scene_name'],
+            frame_idx=info['frame_idx'],
+            timestamp=info['timestamp'],
+            map_location=info['location'],
+        )
+        lidar2ego = np.eye(4)
+        lidar2ego[:3, :3] = Quaternion(info['lidar2ego_rotation']).rotation_matrix
+        lidar2ego[:3, 3] = info['lidar2ego_translation']
+        assert np.allclose(lidar2ego, np.eye(4)), 'NAVSIM stores lidar2ego as the identity; the GT assumes ego == lidar'
+        input_dict['lidar2ego'] = lidar2ego.astype(np.float32)
+
+        ego2global = np.eye(4)
+        ego2global[:3, :3] = Quaternion(info['e2g_rotation']).rotation_matrix
+        ego2global[:3, 3] = info['e2g_translation']
+        image_paths, lidar2img, lidar2cam, cam_intrinsic, camera2ego, camera_intrinsics = [], [], [], [], [], []
+        cam_distortion = []
+        for name in self.camera_names:
+            cam = info['cams'][name]
+            path = cam['img_fpath']
+            if self.sensor_root is not None:
+                assert path.startswith(self.sensor_src_root), f'{path} is not under {self.sensor_src_root}'
+                path = self.sensor_root + path[len(self.sensor_src_root):]
+            image_paths.append(path)
+            K = np.eye(4)
+            K[:3, :3] = np.asarray(cam['intrinsics'], dtype=np.float64)
+            ego2cam = np.asarray(cam['extrinsics'], dtype=np.float64)
+            lidar2img.append(K @ ego2cam)              # lidar == ego; the image loader applies the resize
+            lidar2cam.append(ego2cam)
+            cam_intrinsic.append(K)
+            camera2ego.append(np.linalg.inv(ego2cam).astype(np.float32))
+            camera_intrinsics.append(K.astype(np.float32))
+            cam_distortion.append(np.asarray(cam.get('distortion', np.zeros(5)), dtype=np.float64))
+        input_dict.update(
+            cam_distortion=cam_distortion,  # OpenCV (k1, k2, p1, p2, k3); used only by LoadNavsimMultiViewImages(undistort)
+            img_filename=image_paths,
+            lidar2img=lidar2img,
+            lidar2cam=lidar2cam,
+            cam_intrinsic=cam_intrinsic,
+            camera2ego=camera2ego,
+            camera_intrinsics=camera_intrinsics,
+            lidar2global=ego2global,
+        )
+        # Mask2Map's test path reads can_bus[:3] and [-1] (video mode only); the network never uses it.
+        can_bus = np.zeros(18)
+        rotation = Quaternion(info['e2g_rotation'])
+        can_bus[:3] = info['e2g_translation']
+        can_bus[3:7] = rotation
+        patch_angle = quaternion_yaw(rotation) / np.pi * 180
+        if patch_angle < 0:
+            patch_angle += 360
+        can_bus[-2] = patch_angle / 180 * np.pi
+        can_bus[-1] = patch_angle
+        input_dict['can_bus'] = can_bus
+        return input_dict
+
+    # ----------------------------------------------------------------------------------------------------------- #
+    # ground truth
+    # ----------------------------------------------------------------------------------------------------------- #
+    def get_bev_gt(self, token):
+        """(4, 200, 200) uint8 multi-label BEV raster in the raw frame (row 0 = y -32 m, col 0 = x 0 m)."""
+        geoms = self.map_gt.geoms(token)
+        by_label = {self.cat2label[c]: geoms[c] for c in self.MAPCLASSES}
+        return self.rasterizer(by_label, len(self.MAPCLASSES))
+
+    def navsim_gt_pipeline(self, example, input_dict):
+        bev = self.get_bev_gt(input_dict['token'])
+        example['gt_seg_mask'] = DC(torch.from_numpy(bev), cpu_only=False)
+        if self.aux_seg.get('pv_seg', False):
+            meta = example['img_metas'].data
+            pv = pv_ground_labels(
+                bev, np.stack(input_dict['camera2ego']), np.stack(input_dict['camera_intrinsics']),
+                np.stack(meta['img_aug_matrix']), meta['pad_shape'][0], meta['ori_shape'][0],
+                feat_down_sample=self.aux_seg['feat_down_sample'], ground_z=self.pv_ground_z,
+                roi_size=self.roi_size, roi_center=self.roi_center, supersample=self.pv_supersample,
+                line_classes=[self.cat2label[c] for c in self.LINE_CLASSES])
+            example['gt_pv_seg_mask'] = DC(torch.from_numpy(pv), cpu_only=False)
+        return example
+
+    def prepare_train_data(self, index):
+        input_dict = self.get_data_info(index)
+        self.pre_pipeline(input_dict)
+        example = self.pipeline(input_dict)
+        example = self.navsim_gt_pipeline(example, input_dict)
+        return self.union2one([example])
+
+    def prepare_test_data(self, index):
+        input_dict = self.get_data_info(index)
+        self.pre_pipeline(input_dict)
+        return self.pipeline(input_dict)
+
+    # ----------------------------------------------------------------------------------------------------------- #
+    # evaluation
+    # ----------------------------------------------------------------------------------------------------------- #
+    def evaluate(self, results, logger=None, **kwargs):
+        """ReSMap stage-1 BEV metric over the dataset (no visibility mask, whole 64 x 64 m canvas).
+
+        results: one dict per frame with 'pts_bbox' = {'token', 'seg_label' (H, W) uint8 with 0 = background and
+        k + 1 = class k (argmax, kept if sigmoid >= eval_score_thr), 'seg_bits' packed (C, H, W) sigmoid >= 0.5}.
+        """
+        from mmcv.utils import print_log
+        C = len(self.MAPCLASSES)
+        inter, union = np.zeros(C), np.zeros(C)
+        inter_ml, union_ml = np.zeros(C), np.zeros(C)
+        seen = set()
+        for res in results:
+            r = res['pts_bbox'] if 'pts_bbox' in res else res
+            token = r['token']
+            if token in seen:  # the distributed sampler pads the last batch with repeats
+                continue
+            seen.add(token)
+            gt = self.get_bev_gt(token).astype(bool)
+            label = np.asarray(r['seg_label'])
+            ml = np.unpackbits(np.asarray(r['seg_bits']))[:gt.size].reshape(gt.shape).astype(bool)
+            for c in range(C):
+                p, g = label == c + 1, gt[c]
+                inter[c] += np.logical_and(p, g).sum()
+                union[c] += np.logical_or(p, g).sum()
+                inter_ml[c] += np.logical_and(ml[c], g).sum()
+                union_ml[c] += np.logical_or(ml[c], g).sum()
+        iou = inter / (union + 1e-7)
+        iou_ml = inter_ml / (union_ml + 1e-7)
+        out = {}
+        for c, name in enumerate(self.MAPCLASSES):
+            out[f'NavsimSeg/{name}'] = float(iou[c])
+            out[f'NavsimSeg/{name}_ml'] = float(iou_ml[c])
+        out['NavsimSeg/mIoU'] = float(iou.mean())
+        out['NavsimSeg/mIoU_ml'] = float(iou_ml.mean())
+        out['NavsimSeg/num_frames'] = len(seen)
+        table = '  '.join(f'{n}={iou[c]:.4f}' for c, n in enumerate(self.MAPCLASSES))
+        print_log(f'[NavsimSeg] {len(seen)} frames, ReSMap rule (argmax, sigmoid>={self.eval_score_thr}): {table}  '
+                  f'mIoU={iou.mean():.4f}', logger=logger)
+        table = '  '.join(f'{n}={iou_ml[c]:.4f}' for c, n in enumerate(self.MAPCLASSES))
+        print_log(f'[NavsimSeg] multi-label (sigmoid>=0.5): {table}  mIoU={iou_ml.mean():.4f}', logger=logger)
+        if len(seen) != len(self):
+            print_log(f'[NavsimSeg] WARNING: {len(seen)} evaluated frames != {len(self)} in the dataset',
+                      logger=logger)
+        return out
