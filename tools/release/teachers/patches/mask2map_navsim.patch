diff --git a/projects/mmdet3d_plugin/datasets/navsim_map_utils.py b/projects/mmdet3d_plugin/datasets/navsim_map_utils.py
new file mode 100644
index 0000000..a0b2172
--- /dev/null
+++ b/projects/mmdet3d_plugin/datasets/navsim_map_utils.py
@@ -0,0 +1,305 @@
+"""NAVSIM helpers for the Mask2Map port: map GT store, ReSMap-identical BEV rasteriser, PV ground truth, PCD reader.
+
+Frames
+------
+* ego (E): NAVSIM / nuPlan rear-axle frame, x forward, y left, z up.  LiDAR == ego (lidar2ego is the identity) and
+  MergedPointCloud is stored in it.  The ground is at z ~= -0.33 m (median ground mode over 40 random navtrain
+  frames, p10 -0.35, p90 -0.31).
+* ROI-centred (C): x_c = x - roi_center[0], y_c = y - roi_center[1].  The packed map GT is stored in C
+  (tools/navsim/navsim_map_gt.py), exactly as resmap_navsim's.
+
+BEV raster (identical to resmap_navsim plugin/datasets/pipelines/rasterize.py, semantic mode)
+-------------------------------------------------------------------------------------------
+canvas_size = (W, H) = (200, 200) over roi_size = (64, 64) m, i.e. 3.125 px/m:
+    col = int(3.125 * x_c + 100) = int(3.125 * x)          col 0 = x in [0, 0.32) m (rear axle), col 199 = 63.7 m
+    row = int(3.125 * y_c + 100) = int(3.125 * y + 100)    row 0 = y in [-32, -31.68) m (RIGHT), row 199 = left
+Area classes (road / walkway / crosswalk) are filled with holes punched out, lines (centerline) are 3 px polylines,
+channels are multi-label in class order.  Mask2Map's LSS BEV has the same orientation (rows = y from y_min, cols =
+x from x_min, see LSSTransform: bev_pool -> (B, C, X, Y) -> permute -> (B, C, Y, X)), so the seg loss needs no flip.
+ReSMap's BEVFormer BEV is flipped on H instead (row 0 = y = +32), which is why its loss flips the GT and why a
+ReSMap-layout cache of this model needs exactly one H flip.
+"""
+import numpy as np
+from shapely import affinity
+from shapely.geometry import LineString, Polygon
+
+NAVSIM_MAP_CLASSES = ('road', 'walkway', 'centerline', 'crosswalk')
+
+
+class NavsimMapGT(object):
+    """Memory-mapped flat map GT (tools/navsim/pack_map_gt.py), shared read-only by every dataloader worker.
+
+    Port of resmap_navsim NavsimDataset._load_navsim_map_gt / _map_geoms_for.
+    """
+
+    def __init__(self, path, roi_size, roi_center, class_names):
+        assert str(path).endswith('.npz'), f'map GT must be the packed .npz, got {path}'
+        z = np.load(path, mmap_mode='r')
+        roi = tuple(float(v) for v in z['roi_size'])
+        ctr = tuple(float(v) for v in z['roi_center'])
+        assert roi == tuple(float(v) for v in roi_size), f'map GT roi {roi} != config roi {tuple(roi_size)}'
+        assert ctr == tuple(float(v) for v in roi_center), f'map GT centre {ctr} != config centre {tuple(roi_center)}'
+        classes = [c.decode() for c in z['classes']]
+        unknown = set(class_names) - set(classes)
+        assert not unknown, f'map classes {unknown} are not in the map GT {classes}'
+        self.path = path
+        self.class_names = list(class_names)
+        self.coords = z['coords']          # (N, 2) float32
+        self.ring_off = z['ring_off']      # (R + 1,)
+        self.ring_cls = z['ring_cls']      # (R,) index into `classes`
+        self.ring_poly = z['ring_poly']    # (R,) polygon id inside a token; holes share it
+        self.tok_off = z['tok_off']        # (T + 1,)
+        self.gt_classes = classes
+        self.area_classes = set(c.decode() for c in z['area_classes'])
+        self.row = {t.decode(): i for i, t in enumerate(z['tokens'])}
+
+    def __contains__(self, token):
+        return token in self.row
+
+    def geoms(self, token):
+        """{class_name: [Polygon | LineString]} in the ROI-centred frame, for the requested classes."""
+        row = self.row[token]
+        r0, r1 = int(self.tok_off[row]), int(self.tok_off[row + 1])
+        out = {name: [] for name in self.class_names}
+        r = r0
+        while r < r1:
+            ci = int(self.ring_cls[r])
+            name = self.gt_classes[ci]
+            poly_id = int(self.ring_poly[r])
+            rings = []
+            while r < r1 and int(self.ring_poly[r]) == poly_id and int(self.ring_cls[r]) == ci:
+                a, b = int(self.ring_off[r]), int(self.ring_off[r + 1])
+                rings.append(np.asarray(self.coords[a:b], dtype=np.float64))
+                r += 1
+            if name not in out:
+                continue
+            if name in self.area_classes:
+                if len(rings[0]) < 3:
+                    continue
+                g = Polygon(rings[0], [h for h in rings[1:] if len(h) >= 3])
+                if not g.is_valid:
+                    g = g.buffer(0)
+                if g.geom_type == 'Polygon' and not g.is_empty:
+                    out[name].append(g)
+                elif g.geom_type == 'MultiPolygon':
+                    out[name].extend(gg for gg in g.geoms if not gg.is_empty)
+            else:
+                for arr in rings:
+                    if len(arr) >= 2:
+                        out[name].append(LineString(arr))
+        return out
+
+
+class NavsimBEVRasterizer(object):
+    """ReSMap's RasterizeMap (semantic_mask=True, fill_line_classes=()) as a plain function object.
+
+    The arithmetic (shapely scale about the origin, shift by half the canvas, int32 truncation, cv2 fill / polylines)
+    is kept verbatim so the masks are byte-identical to the ones the ReSMap front64 teacher was trained on.
+    """
+
+    def __init__(self, roi_size=(64.0, 64.0), canvas_size=(200, 200), thickness=3):
+        self.roi_size = tuple(roi_size)
+        self.canvas_size = tuple(canvas_size)       # (W, H)
+        self.scale_x = self.canvas_size[0] / self.roi_size[0]
+        self.scale_y = self.canvas_size[1] / self.roi_size[1]
+        self.thickness = thickness
+
+    def _line(self, line, mask):
+        import cv2
+        line = affinity.scale(line, self.scale_x, self.scale_y, origin=(0, 0))
+        line = affinity.affine_transform(line, [1.0, 0.0, 0.0, 1.0, self.canvas_size[0] / 2, self.canvas_size[1] / 2])
+        coords = np.array(list(line.coords), dtype=np.int32)[:, :2].reshape((-1, 2))
+        assert len(coords) >= 2
+        cv2.polylines(mask, np.int32([coords]), False, color=1, thickness=self.thickness)
+
+    def _polygons(self, polygons):
+        import cv2
+        H, W = self.canvas_size[1], self.canvas_size[0]
+        out = np.zeros((H, W), dtype=np.uint8)
+        for polygon in polygons:
+            polygon = affinity.scale(polygon, self.scale_x, self.scale_y, origin=(0, 0))
+            polygon = affinity.affine_transform(
+                polygon, [1.0, 0.0, 0.0, 1.0, self.canvas_size[0] / 2, self.canvas_size[1] / 2])
+            m = np.zeros((H, W), dtype=np.uint8)
+            ext = np.array(polygon.exterior.coords)[:, :2].astype(np.int32)
+            if len(ext) >= 3:
+                cv2.fillPoly(m, [ext.reshape(-1, 1, 2)], color=1)
+            for hole in polygon.interiors:
+                h = np.array(hole.coords)[:, :2].astype(np.int32)
+                if len(h) >= 3:
+                    cv2.fillPoly(m, [h.reshape(-1, 1, 2)], color=0)
+            out = np.maximum(out, m)
+        return out
+
+    def __call__(self, geoms_by_label, num_classes):
+        """geoms_by_label: {label: [LineString | Polygon]} -> (num_classes, H, W) uint8."""
+        mask = np.zeros((num_classes, self.canvas_size[1], self.canvas_size[0]), dtype=np.uint8)
+        for label, geom_list in geoms_by_label.items():
+            if len(geom_list) == 0:
+                continue
+            if geom_list[0].geom_type == 'LineString':
+                for line in geom_list:
+                    self._line(line, mask[label])
+            elif geom_list[0].geom_type == 'Polygon':
+                mask[label] = np.maximum(mask[label], self._polygons(geom_list))
+            else:
+                raise ValueError('map geoms must be either LineString or Polygon')
+        return np.ascontiguousarray(mask)
+
+
+def pv_ground_labels(bev_mask, cam2ego, intrinsics, img_aug_matrix, pad_shape, img_shape, feat_down_sample=32,
+                     ground_z=-0.33, roi_size=(64.0, 64.0), roi_center=(32.0, 0.0), supersample=4, line_classes=(2,)):
+    """Perspective-view GT by inverse perspective mapping of the BEV raster.
+
+    Mask2Map's nuScenes code draws the map *polylines* into the stride-32 feature grid; NAVSIM's road / walkway /
+    crosswalk are areas, so here every PV sample casts its pinhole ray to the ground plane z = ground_z (ego frame)
+    and reads the BEV raster where it lands, at supersample x supersample sub-pixel rays per feature cell.  A cell is
+    positive for a line class (`line_classes`, e.g. centerline) if any of its rays is -- the "cell the line passes
+    through" rule of Mask2Map's thickness-1 polyline drawing -- and for an area class if at least half of its rays
+    are.  Rays that miss the ground, land outside the ROI, or start in the bottom / right padding are background.
+
+    Args:
+        bev_mask (ndarray): (C, H, W) uint8, the NavsimBEVRasterizer output.
+        cam2ego (ndarray): (N, 4, 4).
+        intrinsics (ndarray): (N, 4, 4) or (N, 3, 3), calibrated for the ORIGINAL image.
+        img_aug_matrix (ndarray): (N, 4, 4) original pixels -> network pixels (the pipeline resize).
+        pad_shape, img_shape: (H, W, ...) of the padded and of the unpadded network image.
+    Returns:
+        (N, C, pad_H // s, pad_W // s) uint8.
+    """
+    C, H, W = bev_mask.shape
+    N = len(cam2ego)
+    fH, fW = int(pad_shape[0]) // feat_down_sample, int(pad_shape[1]) // feat_down_sample
+    S = supersample
+    offs = (np.arange(S) + 0.5) * feat_down_sample / S
+    us = (np.arange(fW)[:, None] * feat_down_sample + offs[None, :]).reshape(-1)          # (fW * S,)
+    vs = (np.arange(fH)[:, None] * feat_down_sample + offs[None, :]).reshape(-1)          # (fH * S,)
+    uu, vv = np.meshgrid(us, vs)                                                         # (fH*S, fW*S)
+    in_img = (uu < img_shape[1]) & (vv < img_shape[0])
+    pix = np.stack([uu, vv, np.ones_like(uu)], -1).reshape(-1, 3).T                      # (3, M)
+    sx, sy = roi_size[0] / W, roi_size[1] / H                                            # m per px (forward, lateral)
+    out = np.zeros((N, C, fH, fW), dtype=np.uint8)
+    for n in range(N):
+        A = np.asarray(img_aug_matrix[n], dtype=np.float64)
+        K = np.asarray(intrinsics[n], dtype=np.float64)[:3, :3]
+        T = np.asarray(cam2ego[n], dtype=np.float64)
+        # network pixel -> original pixel (undo resize; img_aug is diag(sx, sy, 1, 1) + optional translation)
+        p = np.linalg.solve(A[:3, :3], pix - A[:3, 3:4])
+        d = T[:3, :3] @ np.linalg.solve(K, p)                                            # ray dirs in ego
+        o = T[:3, 3]
+        with np.errstate(divide='ignore', invalid='ignore'):
+            lam = (ground_z - o[2]) / d[2]
+        ok = (d[2] < -1e-6) & (lam > 0) & in_img.reshape(-1)
+        x = o[0] + lam * d[0] - roi_center[0]                                            # ROI-centred
+        y = o[1] + lam * d[1] - roi_center[1]
+        ok &= (np.abs(x) < roi_size[0] / 2) & (np.abs(y) < roi_size[1] / 2)
+        col = np.where(ok, (x / sx + W / 2), 0).astype(np.int32)                         # same truncation as the raster
+        row = np.where(ok, (y / sy + H / 2), 0).astype(np.int32)
+        ok &= (col >= 0) & (col < W) & (row >= 0) & (row < H)
+        lab = np.zeros((C, ok.size), dtype=np.uint8)
+        lab[:, ok] = bev_mask[:, row[ok], col[ok]]
+        lab = lab.reshape(C, fH, S, fW, S)
+        is_line = np.zeros(C, dtype=bool)
+        is_line[list(line_classes)] = True
+        out[n] = np.where(is_line[:, None, None], lab.max(axis=(2, 4)), lab.mean(axis=(2, 4)) >= 0.5)
+    return out
+
+
+# --------------------------------------------------------------------------------------------------------------- #
+# PCD reader (NAVSIM MergedPointCloud: FIELDS x y z intensity lidar_info ring, binary, 15 B / point).  Adapted from
+# yyongjae/bevfusion@navsim-100x100-cache mmdet3d/datasets/pipelines/loading_utils.py.
+# --------------------------------------------------------------------------------------------------------------- #
+_PCD_NUMPY_TYPE = {
+    ('F', 4): 'f4', ('F', 8): 'f8',
+    ('U', 1): 'u1', ('U', 2): 'u2', ('U', 4): 'u4', ('U', 8): 'u8',
+    ('I', 1): 'i1', ('I', 2): 'i2', ('I', 4): 'i4', ('I', 8): 'i8',
+}
+
+
+def _lzf_decompress(data, expected_len):
+    """Pure-python LZF decompression (fallback when python-lzf is absent)."""
+    out = bytearray()
+    i, n = 0, len(data)
+    while i < n:
+        ctrl = data[i]
+        i += 1
+        if ctrl < 32:
+            out += data[i:i + ctrl + 1]
+            i += ctrl + 1
+        else:
+            length = ctrl >> 5
+            if length == 7:
+                length += data[i]
+                i += 1
+            ref = len(out) - ((ctrl & 0x1F) << 8) - data[i] - 1
+            i += 1
+            if ref < 0:
+                raise ValueError('invalid LZF stream')
+            for _ in range(length + 2):
+                out.append(out[ref])
+                ref += 1
+    if len(out) != expected_len:
+        raise ValueError(f'LZF size mismatch: {len(out)} != {expected_len}')
+    return bytes(out)
+
+
+def read_pcd(path):
+    """Read a PCD file (binary, binary_compressed or ascii) into a structured numpy array."""
+    import struct
+    with open(path, 'rb') as f:
+        header = {}
+        while True:
+            line = f.readline()
+            if not line:
+                raise ValueError(f'truncated PCD header: {path}')
+            text = line.decode('utf-8', 'replace').strip()
+            if not text or text.startswith('#'):
+                continue
+            key, _, value = text.partition(' ')
+            header[key.upper()] = value.strip()
+            if key.upper() == 'DATA':
+                break
+        fields = header['FIELDS'].split()
+        sizes = [int(x) for x in header['SIZE'].split()]
+        types = header['TYPE'].split()
+        counts = [int(c) for c in header.get('COUNT', ' '.join(['1'] * len(fields))).split()]
+        n_points = int(header['POINTS']) if 'POINTS' in header else int(header['WIDTH']) * int(header['HEIGHT'])
+        kind = header['DATA'].lower()
+        names, formats = [], []
+        for name, size, typ, count in zip(fields, sizes, types, counts):
+            fmt = _PCD_NUMPY_TYPE[(typ.upper(), size)]
+            names.append(name)
+            formats.append(f'{count}{fmt}' if count > 1 else fmt)
+        dtype = np.dtype({'names': names, 'formats': formats})
+        if kind == 'binary':
+            return np.frombuffer(f.read(dtype.itemsize * n_points), dtype=dtype, count=n_points)
+        if kind == 'binary_compressed':
+            comp_len, uncomp_len = struct.unpack('II', f.read(8))
+            payload = f.read(comp_len)
+            try:
+                import lzf
+                raw = lzf.decompress(payload, uncomp_len)
+            except ImportError:
+                raw = _lzf_decompress(payload, uncomp_len)
+            out = np.empty(n_points, dtype=dtype)
+            offset = 0
+            for name in dtype.names:  # field-major
+                sub = dtype[name]
+                nbytes = sub.itemsize * n_points
+                out[name] = np.frombuffer(raw[offset:offset + nbytes], dtype=sub, count=n_points)
+                offset += nbytes
+            return out
+        if kind == 'ascii':
+            return np.loadtxt(f, dtype=dtype)
+        raise ValueError(f'unsupported PCD DATA type: {kind}')
+
+
+def load_pcd_points(path, load_dim=5):
+    """(N, load_dim) float32 [x, y, z, intensity, ring] (missing fields are zeros), in the ego frame for NAVSIM."""
+    arr = read_pcd(path)
+
+    def col(name):
+        return arr[name].astype(np.float32) if name in arr.dtype.names else np.zeros(len(arr), np.float32)
+
+    pts = np.stack([col('x'), col('y'), col('z'), col('intensity'), col('ring')], axis=-1)
+    return np.ascontiguousarray(pts[:, :load_dim], dtype=np.float32)
