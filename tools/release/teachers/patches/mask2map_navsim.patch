index 0000000..d4883bc
--- /dev/null
+++ b/tools/navsim/cache_teacher_m2m.py
@@ -0,0 +1,299 @@
+"""Dump the trained Mask2Map NAVSIM teacher's BEV (and seg logits) in the ReSMap stage-1 cache layout.
+
+Layout (the one SSR's ResmapCache / TeacherFeatureStore read, = resmap_navsim tools/cache_teacher_kd_seg.py):
+    <out>/meta.json, <out>/index.json {token: [shard, row]}, <out>/index_r{rank}.json
+    <out>/bev/r{rank}_s{NNNN}.npy   (N, 256, 100, 100) float16
+    <out>/seg/r{rank}_s{NNNN}.npy   (N, 4, 200, 200)   float16 logits (not thresholded)
+Axes: (C, lateral, forward) with row 0 = y_left +32 m and column 0 = x 0 m (rear axle), 0.64 m (bev) / 0.32 m (seg)
+cells, i.e. ReSMap's.  Mask2Map's LSS BEV and seg logits have row 0 = y -32 m (see navsim_map_utils), so both are
+flipped once on rows here; nothing else changes (no transpose, no W flip).
+
+`bev` is the tensor the seg head reads: the LSS output after its stride-2 block (post BN + ReLU, so about half the
+values are exactly 0; ReSMap's BEVFormer output is not rectified).  `--bev-tap pre_relu` caches the same block's BN
+output before the last ReLU instead.  Either way SSR needs a new norm file and a refiner MAP teacher trained on it.
+
+The model is single-frame, so frames are independent: each rank takes every world-th frame and can resume.
+An output directory belongs to one checkpoint / config / world size (provenance.json): a new run refuses a non-empty
+directory, and --resume refuses a different checkpoint, settings or world size.  Before writing, the free space is
+checked against the remaining frames x 5.44 MB (bev 5.12 MB + seg 0.32 MB per frame).  Ranks only meet in one gloo
+barrier at the end, so no NCCL setup is needed.
+
+    torchrun --nproc_per_node=4 tools/navsim/cache_teacher_m2m.py \
+        --cfg <work_dir>/M2M_navsim_front64_r50_sem_18ep.py --ckpt <work_dir>/epoch_18.pth \
+        --split none --out /path/teacher_cache/mask2map/front64
+    # navtest (allow-list tokens only):
+    torchrun ... --split none --only-split-tokens \
+        --ann-file .../infos/navsim_map_infos_navtest.pkl --map-gt-file .../map_gt_navsim_front64x64/navtest.npz \
+        --out /path/teacher_cache/mask2map/front64/navtest
+"""
+import argparse
+import glob
+import hashlib
+import json
+import os
+import os.path as osp
+import sys
+import time
+from datetime import timedelta
+
+import numpy as np
+import torch
+import torch.distributed as dist
+from mmcv import Config
+from mmcv.parallel import MMDataParallel, collate
+from mmcv.runner import get_dist_info, init_dist, load_checkpoint
+
+sys.path.insert(0, osp.dirname(osp.dirname(osp.dirname(osp.abspath(__file__)))))
+import projects.mmdet3d_plugin  # noqa: F401,E402  registers the plugin modules
+from mmdet3d.datasets import build_dataset  # noqa: E402
+from mmdet3d.models import build_model  # noqa: E402
+
+TENSORS = ('bev', 'seg')
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument('--cfg', required=True)
+    p.add_argument('--ckpt', required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--split', default='none', help='log_split to cache: train | val | none (every frame of ann_file)')
+    p.add_argument('--ann-file', default=None, help='override data.test.ann_file (e.g. the navtest infos)')
+    p.add_argument('--map-gt-file', default=None, help='override data.test.map_gt_file (must cover --ann-file)')
+    p.add_argument('--only-split-tokens', action='store_true', help='only scene-filter allow-list frames')
+    p.add_argument('--token-list', default=None, help='text file of tokens to cache (one per line)')
+    p.add_argument('--bev-tap', choices=['post_relu', 'pre_relu'], default='post_relu')
+    p.add_argument('--shard', type=int, default=2000, help='frames per shard')
+    p.add_argument('--workers', type=int, default=6)
+    p.add_argument('--limit', type=int, default=0, help='stop after N frames per rank (dry run)')
+    p.add_argument('--resume', action='store_true', help="skip tokens already in this rank's index_r{rank}.json")
+    p.add_argument('--skip-space-check', action='store_true', help='write even if the disk looks too small')
+    return p.parse_args()
+
+
+FRAME_BYTES = 256 * 100 * 100 * 2 + 4 * 200 * 200 * 2  # bev + seg, float16
+
+
+def check_provenance(out, prov, resume):
+    """Rank 0: one output directory = one checkpoint, config, split selection, bev tap and world size."""
+    path = osp.join(out, 'provenance.json')
+    existing = [f for f in ('index.json', 'meta.json') if osp.exists(osp.join(out, f))] + \
+        glob.glob(osp.join(out, 'index_r*.json')) + glob.glob(osp.join(out, '*', 'r*_s*.npy'))
+    if osp.exists(path):
+        with open(path) as f:
+            old = json.load(f)
+        if not resume:
+            raise SystemExit(f'{out} already holds a cache (provenance.json); use --resume or a new --out')
+        diff = {k: (old.get(k), v) for k, v in prov.items() if old.get(k) != v}
+        if diff:
+            raise SystemExit(f'--resume into {out} with different settings: {diff}')
+        return
+    if existing:
+        raise SystemExit(f'{out} is not empty and has no provenance.json ({existing[:3]}...); use a new --out')
+    os.makedirs(out, exist_ok=True)
+    with open(path, 'w') as f:
+        json.dump(prov, f, indent=2)
+
+
+def sha256_file(path, chunk=1 << 20):
+    h = hashlib.sha256()
+    with open(path, 'rb') as f:
+        for block in iter(lambda: f.read(chunk), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+class ShardWriter(object):
+    """Buffers frames and writes one .npy per tensor per shard; index_r{rank}.json is rewritten after every shard."""
+
+    def __init__(self, out, rank, shard_frames):
+        self.out, self.rank, self.shard_frames = out, rank, shard_frames
+        self.buf = {k: [] for k in TENSORS}
+        self.tokens = []
+        self.index_path = osp.join(out, f'index_r{rank}.json')
+        self.index = {}
+        self.shard_id = 0
+        for k in TENSORS:
+            os.makedirs(osp.join(out, k), exist_ok=True)
+
+    def resume(self):
+        if osp.exists(self.index_path):
+            with open(self.index_path) as f:
+                self.index = json.load(f)
+        names = {v[0] for v in self.index.values()}
+        # drop shard files a crash left without an index entry
+        for k in TENSORS:
+            for f in glob.glob(osp.join(self.out, k, f'r{self.rank}_s*.npy')):
+                if osp.basename(f)[:-4] not in names:
+                    os.remove(f)
+        if names:
+            self.shard_id = max(int(n.split('_s')[1]) for n in names) + 1
+        return set(self.index)
+
+    def add(self, token, tensors):
+        self.tokens.append(token)
+        for k in TENSORS:
+            self.buf[k].append(tensors[k])
+        if len(self.tokens) >= self.shard_frames:
+            self.flush()
+
+    def flush(self):
+        if not self.tokens:
+            return
+        name = f'r{self.rank}_s{self.shard_id:04d}'
+        for k in TENSORS:
+            tmp = osp.join(self.out, k, name + '.tmp.npy')
+            np.save(tmp, np.stack(self.buf[k]))
+            os.replace(tmp, osp.join(self.out, k, name + '.npy'))
+            self.buf[k] = []
+        for row, tok in enumerate(self.tokens):
+            self.index[tok] = [name, row]
+        with open(self.index_path + '.tmp', 'w') as f:
+            json.dump(self.index, f)
+        os.replace(self.index_path + '.tmp', self.index_path)
+        self.tokens = []
+        self.shard_id += 1
+
+
+def main():
+    args = parse_args()
+    # as tools/train.py: something in the import chain switches multiprocessing to 'spawn', and the dataset holds
+    # unpicklable objects (dict_keys), so the dataloader workers must fork
+    torch.multiprocessing.set_start_method('fork', force=True)
+    torch.cuda.set_device(int(os.environ.get('LOCAL_RANK', 0)))
+    init_dist('pytorch', backend='gloo', timeout=timedelta(hours=6))  # only a final barrier; avoids NCCL NIC setup
+    rank, world = get_dist_info()
+
+    cfg = Config.fromfile(args.cfg)
+    test = cfg.data.test
+    test.log_split = None if args.split.lower() == 'none' else args.split
+    test.test_mode = True
+    if args.ann_file:
+        test.ann_file = args.ann_file
+    if args.map_gt_file:
+        test.map_gt_file = args.map_gt_file
+    test.split_tokens_only = bool(args.only_split_tokens)
+    if args.token_list:
+        test.token_list = args.token_list
+    cfg.model.train_cfg = None
+    cfg.model.pretrained = None  # the checkpoint holds every weight
+    dataset = build_dataset(test)
+
+    ckpt_sha = sha256_file(args.ckpt) if rank == 0 else None  # hashed before the weights are loaded
+    model = build_model(cfg.model, test_cfg=cfg.get('test_cfg'))
+    if cfg.get('fp16', None) is not None:  # as tools/test.py: the backbone + neck run in fp16, like in training
+        from mmcv.runner import wrap_fp16_model
+        wrap_fp16_model(model)
+    load_checkpoint(model, args.ckpt, map_location='cpu', strict=True)
+    model = MMDataParallel(model.cuda(), device_ids=[torch.cuda.current_device()]).eval()
+    core = model.module
+    head = core.pts_bbox_head
+    assert getattr(head, 'semantic_only', False) and head.aux_seg['bev_seg'], 'expects the semantic_only NAVSIM model'
+
+    cap = {}
+    head.seg_head.register_forward_hook(lambda m, i, o: cap.update(seg=o, bev_post=i[0]))
+    if args.bev_tap == 'pre_relu':
+        ds = head.transformer.encoder.downsample  # conv-BN-ReLU, conv(s2)-BN-ReLU, conv-BN-ReLU
+        assert isinstance(ds[-1], torch.nn.ReLU) and isinstance(ds[-2], torch.nn.BatchNorm2d)
+        # clone: the block's last ReLU runs in place and would rectify the captured tensor
+        ds[-2].register_forward_hook(lambda m, i, o: cap.update(bev_pre=o.clone()))
+
+    # provenance (rank 0's checkpoint hash from before loading; meta.json reuses it)
+    prov = None
+    if rank == 0:
+        prov = dict(checkpoint_sha256=ckpt_sha, cfg=osp.abspath(args.cfg), world_size=world,
+                    split=args.split, ann_file=test.ann_file, map_gt_file=test.get('map_gt_file'),
+                    only_split_tokens=bool(args.only_split_tokens), token_list=args.token_list,
+                    bev_tap=args.bev_tap)
+        check_provenance(args.out, prov, args.resume)
+    dist.barrier()
+    with open(osp.join(args.out, 'provenance.json')) as f:
+        prov = json.load(f)
+
+    writer = ShardWriter(args.out, rank, args.shard)
+    done = writer.resume() if args.resume else set()
+    todo = [i for i in range(rank, len(dataset), world) if dataset.data_infos[i]['token'] not in done]
+    if not args.skip_space_check:
+        need = len(todo) * FRAME_BYTES * world  # every rank has about the same share
+        free = __import__('shutil').disk_usage(args.out).free
+        if need > free * 0.98:
+            raise SystemExit(f'[rank {rank}] about {need / 2**30:.0f} GiB still to write but only {free / 2**30:.0f} '
+                             f'GiB free on {args.out}; free space or pass --skip-space-check')
+    loader = torch.utils.data.DataLoader(
+        torch.utils.data.Subset(dataset, todo), batch_size=1, shuffle=False, num_workers=args.workers,
+        collate_fn=lambda b: collate(b, samples_per_gpu=1), pin_memory=False)
+    if rank == 0:
+        print(f'[cache] {len(dataset)} frames, split={args.split}, {world} ranks, bev tap {args.bev_tap}', flush=True)
+    print(f'[rank {rank}] {len(todo)} frames to write ({len(done)} already cached)', flush=True)
+
+    t0, n = time.time(), 0
+    with torch.no_grad():
+        for data in loader:
+            token = data['img_metas'][0].data[0][0]['sample_idx']
+            model(return_loss=False, rescale=True, **data)
+            bev = cap['bev_pre'] if args.bev_tap == 'pre_relu' else cap['bev_post']
+            tensors = {
+                'bev': bev[0].flip(-2).float().to(torch.float16).cpu().numpy(),   # row 0 = y +32 m (ReSMap layout)
+                'seg': cap['seg'][0].flip(-2).float().to(torch.float16).cpu().numpy(),
+            }
+            if n == 0 and rank == 0:
+                for k, v in tensors.items():
+                    print(f'    {k:4s} {tuple(v.shape)} {v.dtype} range [{float(v.min()):.3f}, {float(v.max()):.3f}] '
+                          f'zero frac {float((v == 0).mean()):.3f}', flush=True)
+            writer.add(token, tensors)
+            n += 1
+            if rank == 0 and n % 500 == 0:
+                rate = n / (time.time() - t0)
+                print(f'[cache] rank0 {n}/{len(todo)} {rate:.1f} frames/s, '
+                      f'eta {timedelta(seconds=int((len(todo) - n) / max(rate, 1e-6)))}', flush=True)
+            if args.limit and n >= args.limit:
+                break
+    writer.flush()
+    print(f'[rank {rank}] done: {n} new frames, {len(writer.index)} in index_r{rank}, {time.time() - t0:.0f}s',
+          flush=True)
+
+    dist.barrier()
+    if rank == 0:
+        index = {}
+        for r in range(world):  # only this run's ranks (provenance pins the world size)
+            with open(osp.join(args.out, f'index_r{r}.json')) as fh:
+                part = json.load(fh)
+            dup = set(part) & set(index)
+            assert not dup, f'{len(dup)} tokens written by two ranks, e.g. {sorted(dup)[:3]}'
+            index.update(part)
+        with open(osp.join(args.out, 'index.json'), 'w') as f:
+            json.dump(index, f)
+        bev_h, bev_w = head.bev_h, head.bev_w
+        n_cls = head.aux_seg['seg_classes']
+        seg_h, seg_w = bev_h * 2 ** head.seg_upsample, bev_w * 2 ** head.seg_upsample
+        meta = {
+            'teacher_config': osp.abspath(args.cfg),
+            'teacher_checkpoint': osp.abspath(args.ckpt),
+            'checkpoint_sha256': prov['checkpoint_sha256'],  # hashed before the weights were loaded
+            'split': args.split,
+            'ann_file': test.ann_file,
+            'map_gt_file': test.get('map_gt_file'),
+            'only_split_tokens': bool(args.only_split_tokens),
+            'token_list': args.token_list,
+            'num_frames': len(index),
+            'classes': list(cfg.map_classes),
+            'roi_size_m': list(cfg.roi_size),
+            'roi_center_m': list(cfg.roi_center),
+            'pc_range': list(cfg.point_cloud_range),
+            'bev_grid': [bev_h, bev_w],
+            'canvas_size': list(cfg.canvas_size),
+            'tensors': {
+                'bev': {'shape': [int(head.embed_dims), bev_h, bev_w], 'dtype': 'float16',
+                        'note': f'Mask2Map LSS BEV ({args.bev_tap}), the seg head input; axes (C, lateral, forward), '
+                                f'row 0 = y +32 m, col 0 = x 0 m, 0.64 m cells'},
+                'seg': {'shape': [n_cls, seg_h, seg_w], 'dtype': 'float16',
+                        'note': 'camera seg logits (seg_head), not thresholded; same axes at 0.32 m'},
+            },
+            'teacher_stage': 'Mask2Map phase-1 semantic_only (LSS BEV + segmentation, no instance / vector head)',
+        }
+        with open(osp.join(args.out, 'meta.json'), 'w') as f:
+            json.dump(meta, f, indent=2)
+        print(f'[cache] index.json: {len(index)} frames; meta.json written', flush=True)
+
+
+if __name__ == '__main__':
+    main()
