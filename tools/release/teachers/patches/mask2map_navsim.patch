+#!/usr/bin/env bash
+# Train Mask2Map phase-1 semantic-only on NAVSIM front64 (the ReSMap front64 stage-1 teacher setting).
+#
+#   GPUS=0,1,2,3 SPG=16 bash tools/navsim/train_front64.sh                 # 4 x 16 = global 64, lr 1.2e-3 (default)
+#   GPUS=0,1,2,3,4,5,6,7 SPG=8 bash tools/navsim/train_front64.sh          # 8 x 8 = global 64, lr 1.2e-3
+# RTX 5090 (32 GB), measured on one GPU: SPG 8 0.225 s/it 10.3 GB, SPG 16 0.385 s/it 17.1 GB (throughput saturates),
+# SPG 24 0.58 s/it 26.5 GB.
+#   GPUS=0 SPG=2 CFG_OPTIONS="data.train.token_list=/path/tokens.txt total_epochs=1 runner.max_epochs=1" \
+#       bash tools/navsim/train_front64.sh --no-validate                   # smoke run
+#
+# lr follows Mask2Map's linear rule, 6e-4 x (GPUs x SPG) / 32.  Extra arguments go to tools/train.py (e.g.
+# --resume-from <ckpt>, --no-validate); extra config overrides go in CFG_OPTIONS (space-separated key=value).
+set -euo pipefail
+for a in "$@"; do
+  if [ "$a" = "--cfg-options" ]; then
+    echo "train_front64.sh: pass config overrides in CFG_OPTIONS (a second --cfg-options would replace the batch/lr ones)" >&2
+    exit 2
+  fi
+done
+
+REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+CFG=${CFG:-$REPO/projects/configs/mask2map_navsim/M2M_navsim_front64_r50_sem_18ep.py}
+GPUS=${GPUS:-0,1,2,3}
+SPG=${SPG:-16}
+WORKERS=${WORKERS:-8}
+PY=${PY:-/venv/m2m/bin/python}
+PORT=${PORT:-29651}
+SEED=${SEED:-0}
+NGPU=$(echo "$GPUS" | tr ',' '\n' | grep -c .)
+LR=${LR:-$($PY -c "print(6e-4 * $NGPU * $SPG / 32)")}
+WORK_DIR=${WORK_DIR:-/workspace/navsim_workspace/mask2map/work_dirs/$(basename "$CFG" .py)_g${NGPU}x${SPG}}
+
+# numpy 1.23's OpenBLAS returns wrong float64 linear algebra on this server's Xeon 8469C unless forced to SkylakeX;
+# NCCL picks a physical NIC and hangs without NCCL_SOCKET_IFNAME=lo (bevfusion setup_fix.md).
+export OPENBLAS_CORETYPE=SkylakeX NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-lo} OMP_NUM_THREADS=${OMP_NUM_THREADS:-2}
+export MPLBACKEND=Agg PYTHONPATH=$REPO:${PYTHONPATH:-}
+cd "$REPO"
+echo "[train_front64] $(TZ=Asia/Seoul date '+%F %T KST') cfg=$CFG gpus=$GPUS spg=$SPG lr=$LR work_dir=$WORK_DIR"
+CUDA_VISIBLE_DEVICES=$GPUS exec nice -n 5 $PY -m torch.distributed.run --nproc_per_node="$NGPU" --master_port="$PORT" \
+    tools/train.py "$CFG" --launcher pytorch --seed "$SEED" --work-dir "$WORK_DIR" "$@" \
+    --cfg-options data.samples_per_gpu="$SPG" data.workers_per_gpu="$WORKERS" optimizer.lr="$LR" ${CFG_OPTIONS:-}
