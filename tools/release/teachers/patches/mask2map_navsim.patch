index 0000000..d7d5fdc
--- /dev/null
+++ b/tools/navsim/create_navsim_infos.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python
+"""Build the NAVSIM (openscene-v1.1) frame infos used by the Mask2Map NAVSIM port.
+
+This is resmap_navsim/tools/create_navsim_infos.py with its hard-coded roots turned into arguments; the frame
+selection and every stored field are unchanged, so the frame set is the one the ReSMap front64 teacher was trained and
+cached on (navtrain: 152,495 frames = 126,032 on train logs + 26,463 on val logs).
+
+Per frame:
+    token, cams{CAM: {img_fpath, intrinsics (3x3, calibrated at 1920x1080), extrinsics (4x4 ego2cam), distortion}},
+    lidar2ego_translation/rotation (identity in nuPlan), e2g_translation (UTM) / e2g_rotation (wxyz),
+    timestamp, location, scene_name, log_name, scene_token, frame_idx, in_split_tokens, sample_idx, prev, next,
+    lidar_path (MergedPointCloud .pcd, in the ego frame)
+
+NAVSIM / nuPlan specifics:
+  * ego == lidar: nuPlan stores lidar2ego as the identity, so cam2ego == cam2lidar and ego2cam = inv(sensor2lidar).
+  * `sensor2lidar_rotation` already uses the optical camera convention (x right, y down, z forward).
+  * The log pkls list every 2 Hz frame, but NAVSIM only ships sensor blobs for the frames its scene filters touch.
+    Those form contiguous runs; each run becomes its own `scene_name` (`{log}#{k}`).
+  * `in_split_tokens` flags the scene-filter allow-list (the current frame of each 4 + 1 + 10 window).
+
+Usage (this server's layout):
+    python tools/navsim/create_navsim_infos.py --filter navtrain \
+        --logs-root /workspace/navsim/download/trainval_navsim_logs/trainval \
+        --blobs-root /workspace/navsim/download/trainval_sensor_blobs/trainval \
+        --out /workspace/navsim_workspace/mask2map/infos/navsim_map_infos_navtrain.pkl
+"""
+import argparse
+import os
+import pickle
+from collections import Counter
+from multiprocessing import Pool
+
+import numpy as np
+import yaml
+
+DEFAULT_SCENE_FILTER_DIR = '/workspace/navsim/navsim/planning/script/config/common/train_test_split/scene_filter'
+
+# NAVSIM ships 8 cameras. A frame is kept only if all of them exist on disk, as in resmap_navsim, so both repos see
+# the same frames; the dataset then selects and orders the cameras that reach the model.
+CAMERA_NAMES = ['CAM_F0', 'CAM_L0', 'CAM_R0', 'CAM_L1', 'CAM_R1', 'CAM_L2', 'CAM_R2', 'CAM_B0']
+
+
+def load_scene_filter(scene_filter_dir, filt):
+    with open(os.path.join(scene_filter_dir, f'{filt}.yaml')) as fh:
+        cfg = yaml.safe_load(fh)
+    return cfg['log_names'], set(cfg['tokens'] or [])
+
+
+def scan_log(job):
+    """-> (log, list of contiguous runs); each run is a list of per-frame dicts."""
+    logs_root, blobs_root, log, cams, min_len, allow = job
+    blob_dir = os.path.join(blobs_root, log)
+    try:
+        have = {c: set(os.listdir(os.path.join(blob_dir, c))) for c in cams}
+    except OSError:
+        return log, []
+    with open(os.path.join(logs_root, f'{log}.pkl'), 'rb') as fh:
+        frames = pickle.load(fh)
+
+    runs, cur, prev_i = [], [], None
+    for i, f in enumerate(frames):
+        cam_meta = f.get('cams') or {}
+        if any(c not in cam_meta or os.path.basename(cam_meta[c]['data_path']) not in have[c] for c in cams):
+            continue
+        if prev_i is not None and i != prev_i + 1:
+            runs.append(cur)
+            cur = []
+        cur.append((i, f))
+        prev_i = i
+    if cur:
+        runs.append(cur)
+
+    out = []
+    for k, run in enumerate(runs):
+        if len(run) < min_len:
+            continue
+        scene_name = f'{log}#{k}'
+        samples = []
+        for local_idx, (_, f) in enumerate(run):
+            cam_dict = {}
+            for c in cams:
+                cm = f['cams'][c]
+                cam2ego = np.eye(4)  # lidar2ego is the identity in nuPlan
+                cam2ego[:3, :3] = np.asarray(cm['sensor2lidar_rotation'], dtype=np.float64)
+                cam2ego[:3, 3] = np.asarray(cm['sensor2lidar_translation'], dtype=np.float64)
+                cam_dict[c] = dict(
+                    img_fpath=os.path.join(blob_dir, cm['data_path'].split('/', 1)[1]),
+                    intrinsics=np.asarray(cm['cam_intrinsic'], dtype=np.float64),
+                    extrinsics=np.linalg.inv(cam2ego),  # ego2cam
+                    distortion=np.asarray(cm['distortion'], dtype=np.float64),
+                )
+            samples.append(dict(
+                token=str(f['token']),
+                cams=cam_dict,
+                lidar2ego_translation=list(map(float, f['lidar2ego_translation'])),
+                lidar2ego_rotation=list(map(float, f['lidar2ego_rotation'])),
+                e2g_translation=list(map(float, f['ego2global_translation'])),
+                e2g_rotation=list(map(float, f['ego2global_rotation'])),
+                timestamp=int(f['timestamp']),
+                location=str(f['map_location']),
+                scene_name=scene_name,
+                log_name=str(f['log_name']),
+                scene_token=str(f['scene_token']),
+                frame_idx=int(f['frame_idx']),
+                in_split_tokens=(not allow) or (str(f['token']) in allow),
+                sample_idx=local_idx,  # renumbered to a global index below
+                prev=-1 if local_idx == 0 else 0,
+                next=-1 if local_idx == len(run) - 1 else 0,
+                lidar_path=os.path.join(blob_dir, f['lidar_path'].split('/', 1)[1]) if f.get('lidar_path') else None,
+            ))
+        out.append(samples)
+    return log, out
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument('--filter', required=True, help='scene filter name, e.g. navtrain or navtest')
+    ap.add_argument('--logs-root', required=True, help='dir with the {log}.pkl navsim logs of this split')
+    ap.add_argument('--blobs-root', required=True, help='dir with the {log}/{CAM}/*.jpg sensor blobs of this split')
+    ap.add_argument('--scene-filter-dir', default=DEFAULT_SCENE_FILTER_DIR)
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--cams', nargs='+', default=CAMERA_NAMES)
+    ap.add_argument('--min-seq', type=int, default=2, help='drop contiguous runs shorter than this')
+    ap.add_argument('--workers', type=int, default=12)
+    args = ap.parse_args()
+
+    logs, allow_tokens = load_scene_filter(args.scene_filter_dir, args.filter)
+    print(f'[info] {args.filter}: {len(logs)} logs, {len(allow_tokens)} allow-list tokens, cams={args.cams}', flush=True)
+
+    jobs = [(args.logs_root, args.blobs_root, log, args.cams, args.min_seq, allow_tokens) for log in logs]
+    all_scenes = []
+    with Pool(args.workers) as pool:
+        for i, (log, runs) in enumerate(pool.imap(scan_log, jobs, chunksize=4)):
+            all_scenes.extend(runs)
+            if (i + 1) % 100 == 0:
+                print(f'[info]   {i + 1}/{len(logs)} logs, {len(all_scenes)} scenes so far', flush=True)
+
+    samples = [s for scene in all_scenes for s in scene]
+    # sample_idx / prev / next are GLOBAL indices (nuScenes info convention).
+    for gi, s in enumerate(samples):
+        s['sample_idx'] = gi
+        s['prev'] = -1 if s['prev'] == -1 else gi - 1
+        s['next'] = -1 if s['next'] == -1 else gi + 1
+
+    lens = [len(s) for s in all_scenes]
+    loc = Counter(s['location'] for s in samples)
+    print(f'[info] scenes={len(all_scenes)} samples={len(samples)}')
+    print(f'[info] scene length: min={min(lens)} med={int(np.median(lens))} mean={np.mean(lens):.1f} max={max(lens)}')
+    print(f'[info] per-city samples: {dict(loc)}')
+    n_allow = sum(1 for s in samples if s['in_split_tokens'])
+    print(f'[info] in scene-filter allow-list: {n_allow} / {len(samples)} (allow-list size {len(allow_tokens)}, '
+          f'missing {len(allow_tokens - {s["token"] for s in samples})})')
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, 'wb') as fh:
+        pickle.dump(samples, fh)
+    print(f'[info] wrote {args.out}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/navsim/navsim_map_gt.py b/tools/navsim/navsim_map_gt.py
