@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Evaluate a Mask2Map NAVSIM checkpoint with ReSMap's BEV seg metric (+ multi-label IoU).
+#
+#   GPUS=0,1,2,3 bash tools/navsim/test_front64.sh <ckpt>            # val logs (26,463 frames)
+#   GPUS=0,1,2,3 bash tools/navsim/test_front64.sh <ckpt> navtest    # navtest allow-list (12,146 tokens)
+#
+# CFG defaults to the config dumped next to the checkpoint by tools/train.py.
+set -euo pipefail
+
+REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+CKPT=${1:?usage: test_front64.sh <ckpt> [val|navtest]}
+SPLIT=${2:-val}
+CFG=${CFG:-$(ls "$(dirname "$CKPT")"/M2M_navsim_*.py | head -1)}  # the config tools/train.py dumped next to it
+DATA=${DATA:-/workspace/navsim_workspace/mask2map}
+GPUS=${GPUS:-0,1,2,3}
+WORKERS=${WORKERS:-6}
+PY=${PY:-/venv/m2m/bin/python}
+PORT=${PORT:-29652}
+NGPU=$(echo "$GPUS" | tr ',' '\n' | grep -c .)
+case "$SPLIT" in
+  val) OPTS="data.test.log_split=val" ;;
+  navtest) OPTS="data.test.ann_file=$DATA/infos/navsim_map_infos_navtest.pkl \
+data.test.map_gt_file=$DATA/map_gt_navsim_front64x64/navtest.npz data.test.log_split=None \
+data.test.split_tokens_only=True" ;;
+  *) echo "split must be val or navtest" >&2; exit 2 ;;
+esac
+
+export OPENBLAS_CORETYPE=SkylakeX NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-lo} OMP_NUM_THREADS=${OMP_NUM_THREADS:-2}
+export MPLBACKEND=Agg PYTHONPATH=$REPO:${PYTHONPATH:-}
+cd "$REPO"
+echo "[test_front64] $(TZ=Asia/Seoul date '+%F %T KST') ckpt=$CKPT split=$SPLIT gpus=$GPUS"
+CUDA_VISIBLE_DEVICES=$GPUS exec $PY -m torch.distributed.run --nproc_per_node="$NGPU" --master_port="$PORT" \
+    tools/test.py "$CFG" "$CKPT" --launcher pytorch --eval miou \
+    --cfg-options data.workers_per_gpu="$WORKERS" $OPTS
diff --git a/tools/navsim/train_front64.sh b/tools/navsim/train_front64.sh
new file mode 100755
index 0000000..5489e1f
--- /dev/null
+++ b/tools/navsim/train_front64.sh
