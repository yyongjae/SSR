+"""Pure-PyTorch stand-in for mmdet3d.ops.bev_pool (BEVFusion's QuickCumsum CUDA op), used when that op is not built.
+
+bev_pool(feats, coords, B, D, H, W): feats (N, C), coords (N, 4) long = (x in [0, H), y in [0, W), z in [0, D), batch);
+returns (B, C, D, H, W) with the features of each voxel summed, as the CUDA op does.
+"""
+import torch
+
+
+def bev_pool(feats, coords, B, D, H, W):
+    assert feats.shape[0] == coords.shape[0]
+    B, D, H, W = int(B), int(D), int(H), int(W)
+    c = coords.long()
+    idx = ((c[:, 3] * D + c[:, 2]) * H + c[:, 0]) * W + c[:, 1]
+    out = feats.new_zeros((B * D * H * W, feats.shape[1]))
+    out.index_add_(0, idx, feats)
+    return out.view(B, D, H, W, -1).permute(0, 4, 1, 2, 3).contiguous()
